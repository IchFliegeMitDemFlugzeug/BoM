        Dim docType                                                               ' Тип документа
        docType = "Unknown"                                                       ' По умолчанию Unknown
        If Not (refDoc Is Nothing) Then                                           ' Если документ получен
            docType = TypeName(refDoc)                                            ' Тип документа
        End If                                                                    ' Конец проверки refDoc

