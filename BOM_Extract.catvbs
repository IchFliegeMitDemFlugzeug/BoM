Option Explicit                                                                 ' Требуем явного объявления переменных (меньше “магических” ошибок)

' -----------------------------                                                    ' Раздел комментария
' Точка входа макроса CATIA                                                        ' Описание
' -----------------------------                                                    ' Раздел комментария
Dim gProjectCodes                                                                 ' Глобальный список допустимых префиксов проекта
Dim gRepeatingSubassemblies                                                       ' Глобальный флаг разворачивать повторяющиеся подсборки
Dim gNonDrawingPartsAsMaterials                                                   ' Флаг “бесчертежные ткани -> материалы”
Dim gMassOfStandardParts                                                          ' Флаг “показывать массу стандартных изделий”
Dim gMassOfPKI                                                                    ' Флаг “показывать массу ПКИ”
Dim gCodeRules                                                                    ' Правила заполнения столбца "код" из Code.tsv
Dim gMetalMarks                                                                   ' Список марок металлов из metals_ru_library.tsv
Dim gCompositeKeywords                                                            ' Список ключевых слов для композитов из composites_detect_keywords.tsv
Dim gFabricKeywords                                                               ' Подмножество ключевых слов армирования (признак тканей)

Sub CATMain()                                                                     ' Главная процедура, которую вызывает CATIA

    Dim asmDoc                                                                    ' Переменная для активного документа
    Set asmDoc = CATIA.ActiveDocument                                             ' Берём текущий активный документ CATIA

    If TypeName(asmDoc) <> "ProductDocument" Then                                 ' Если активный документ не сборка (CATProduct)
        MsgBox "Открой активную сборку (CATProduct) и запусти макрос ещё раз.", vbExclamation, "BOM Extract" ' Сообщаем пользователю
        Exit Sub                                                                  ' Выходим из макроса
    End If                                                                        ' Конец проверки типа документа

    Dim rootProd                                                                  ' Переменная для корневого Product
    Set rootProd = asmDoc.Product                                                 ' Получаем корневой продукт сборки

    Dim startLevelText                                                            ' Строка ответа пользователя по стартовому уровню
    startLevelText = InputBox("С какого уровня начать в Excel? Введи: G1..G8 (например G2).", "BOM Extract", "G2") ' Просим уровень

    Dim startLevel                                                                ' Числовой стартовый уровень (1..8)
    startLevel = ParseStartLevel(startLevelText)                                  ' Парсим G1..G8 в число

    If startLevel < 1 Or startLevel > 8 Then                                      ' Если уровень невалиден
        MsgBox "Неверный уровень. Допустимо: G1..G8.", vbExclamation, "BOM Extract" ' Сообщаем
        Exit Sub                                                                  ' Выходим
    End If                                                                        ' Конец проверки уровня

    Dim outXlsx                                                                   ' Путь сохранения Excel
    outXlsx = CATIA.FileSelectionBox("Сохранить спецификацию как Excel", "*.xlsx", 1) ' Диалог “Сохранить как”
    If Trim(outXlsx) = "" Then                                                    ' Если пользователь нажал Cancel
        MsgBox "Сохранение отменено.", vbInformation, "BOM Extract"               ' Сообщаем
        Exit Sub                                                                  ' Выходим
    End If                                                                        ' Конец Cancel
    If LCase(Right(outXlsx, 5)) <> ".xlsx" Then                                   ' Если расширение не .xlsx
        outXlsx = outXlsx & ".xlsx"                                               ' Добавляем расширение
    End If                                                                        ' Конец проверки расширения

    Dim workFolder                                                                ' Папка, где лежат файлы
    workFolder = GetFolderFromFullPath(outXlsx)                                   ' Папка = папка выбранного Excel

    gProjectCodes = DefaultProjectCodes()                                         ' Заполняем список кодов проекта значениями по умолчанию
    gRepeatingSubassemblies = False                                               ' Ставим дефолт для флага раскрутки подсборок

    gNonDrawingPartsAsMaterials = False                                           ' По умолчанию БЧ-детали не переводим в материалы
    gMassOfStandardParts = False                                                  ' По умолчанию не выводим массы стандартных изделий
    gMassOfPKI = False                                                            ' По умолчанию не выводим массы ПКИ

    Dim settingsOk                                                                ' Флаг успешной загрузки настроек
    settingsOk = LoadSettings(workFolder & "\Settings.txt", gProjectCodes, gRepeatingSubassemblies, gNonDrawingPartsAsMaterials, gMassOfStandardParts, gMassOfPKI) ' Пытаемся прочитать настройки пользователя
    If settingsOk = False Then                                                    ' Если Settings.txt не найден или не прочитан
        Exit Sub                                                                  ' Останавливаем выполнение макроса
    End If                                                                        ' Конец проверки Settings.txt
    gCodeRules = LoadCodeRules(workFolder & "\Code.tsv")                        ' Загружаем правила для столбца "код"
    Call LoadMaterialLibraries(workFolder)                                        ' Готовим списки металлов/композитов

    If ArrayLastIndex(gProjectCodes) < 0 Then                                    ' Если список префиксов пуст
        MsgBox "В Settings.txt не задан Project_code. Добавь список префиксов через запятую и запусти макрос заново.", vbExclamation, "BOM Extract" ' Просим заполнить настройку
        Exit Sub                                                                  ' Останавливаем макрос
    End If                                                                        ' Конец проверки Project_code

    Dim builderPath                                                               ' Путь к ExcelBuilder
    builderPath = workFolder & "\ExcelBuilder.vbs"                                ' ExcelBuilder должен лежать рядом

    If FileExists(builderPath) = False Then                                       ' Если ExcelBuilder не найден
        MsgBox "Не найден ExcelBuilder.vbs в папке:" & vbCrLf & workFolder & vbCrLf & _
               "Положи ExcelBuilder.vbs рядом с тем местом, куда сохраняешь Excel.", vbExclamation, "BOM Extract" ' Подсказка
        Exit Sub                                                                  ' Выходим
    End If                                                                        ' Конец проверки ExcelBuilder

    Dim payloadPath                                                               ' Путь к промежуточному payload
    payloadPath = workFolder & "\BOM_payload.tsv"                                 ' Payload кладём рядом

    Dim lines                                                                     ' Массив строк payload
    lines = Array()                                                               ' Инициализируем пустым массивом

    ' Заголовок TSV (для ExcelBuilder)                                             ' Пояснение
    lines = ArrayAppendValue(lines, _
        "Depth" & vbTab & "Kind" & vbTab & "Label" & vbTab & "PartNumber" & vbTab & "Definition" & vbTab & _
        "ParentPN" & vbTab & "Qty" & vbTab & "CodeM" & vbTab & "TypeN" & vbTab & "MaterialO" & vbTab & _
        "MassEachKg" & vbTab & "MassTotalKg")                                     ' Столбцы payload (строго по порядку)

    Dim rootPN                                                                    ' PartNumber корня
    rootPN = SafeGetPartNumber(rootProd)                                          ' Берём PartNumber корневой сборки

    Dim rootDef                                                                   ' Definition корня
    rootDef = SafeGetDefinition(rootProd)                                         ' Берём Definition (fallback внутри)

    Dim rootLineIndex                                                             ' Индекс строки корня в массиве lines
    rootLineIndex = AppendLineReturnIndex(lines, MakeTSVLine(0, "ASM", rootPN, rootPN, rootDef, "", 1, "сб", "", "", 0, 0)) ' Пишем корень (масса позже)

    Dim rootMassEach                                                              ' Масса 1 шт корня
    rootMassEach = ProcessNodeCollect(rootProd, rootPN, 0, lines)                 ' Обходим дерево, заполняем lines, получаем массу корня

    lines(rootLineIndex) = MakeTSVLine(0, "ASM", rootPN, rootPN, rootDef, "", 1, "сб", "", "", rootMassEach, rootMassEach) ' Перезаписываем корень с массой

    If WriteAllTextUnicode(payloadPath, Join(lines, vbCrLf)) = False Then         ' Если не удалось записать файл
        MsgBox "Не удалось записать файл: " & payloadPath, vbExclamation, "BOM Extract" ' Сообщаем
        Exit Sub                                                                  ' Выходим
    End If                                                                        ' Конец проверки записи

    Dim cmd                                                                       ' Команда запуска ExcelBuilder
    cmd = "wscript.exe " & Quote(builderPath) & " " & Quote(payloadPath) & " " & Quote(outXlsx) & " " & CStr(startLevel) ' Передаём payload, xlsx и старт-уровень

    Dim sh                                                                        ' WScript.Shell для запуска
    Set sh = CreateObject("WScript.Shell")                                        ' Создаём shell
    sh.Run cmd, 1, True                                                           ' Запускаем и ждём завершения

    MsgBox "Готово." & vbCrLf & "Excel: " & outXlsx, vbInformation, "BOM Extract" ' Финальное сообщение

End Sub                                                                           ' Конец CATMain


' -----------------------------                                                    ' Раздел комментария
' Рекурсивная обработка узла (сборка)                                              ' Описание
' Возвращает массу 1 шт данного узла                                               ' Описание
' -----------------------------                                                    ' Раздел комментария
Function ProcessNodeCollect(parentProd, parentPN, depth, ByRef lines)             ' Рекурсивный обход

    Dim sumMassEach                                                               ' Масса 1 шт родителя = сумма масс детей
    sumMassEach = 0                                                               ' Начинаем с 0

    Dim matMassDict                                                               ' Словарь "материал -> накопленная масса"
    Set matMassDict = CreateObject("Scripting.Dictionary")                        ' Инициализируем словарь материалов

    Dim dictQty                                                                   ' Словарь количества по позиции
    Set dictQty = CreateObject("Scripting.Dictionary")                            ' key -> qty

    Dim dictFirst                                                                 ' Словарь “первого объекта” для позиции
    Set dictFirst = CreateObject("Scripting.Dictionary")                          ' key -> child object

    Dim dictDocType                                                               ' Словарь типа документа для позиции
    Set dictDocType = CreateObject("Scripting.Dictionary")                        ' key -> "ProductDocument"/"PartDocument"/"Unknown"

    Dim ordASM, ordSGTE, ordFAST, ordPKI                                          ' Массивы порядка по группам
    ordASM = Array()                                                              ' Подсборки
    ordSGTE = Array()                                                             ' Детали SGTE/СГТЕ
    ordFAST = Array()                                                             ' Крепёж (DIN/ОСТ)
    ordPKI = Array()                                                              ' ПКИ (прочие)

    Dim i                                                                         ' Счётчик детей
    For i = 1 To parentProd.Products.Count                                        ' Перебираем детей

        Dim child                                                                 ' Дочерний продукт (экземпляр)
        Set child = parentProd.Products.Item(i)                                   ' Берём ребёнка

        Dim refDoc                                                                ' Документ референса
        Set refDoc = Nothing                                                      ' Инициализация
        On Error Resume Next                                                      ' Перехват (если не загружено)
        Set refDoc = child.ReferenceProduct.Parent                                ' Пытаемся получить документ
        On Error GoTo 0                                                           ' Снимаем перехват

        Dim docType                                                               ' Тип документа
        docType = "Unknown"                                                       ' По умолчанию Unknown
        If Not (refDoc Is Nothing) Then                                           ' Если документ получен
            docType = TypeName(refDoc)                                            ' Тип документа
        End If                                                                    ' Конец проверки refDoc

        Dim childPN                                                               ' PartNumber ребёнка
        childPN = SafeGetPartNumber(child)                                        ' Берём PartNumber

        Dim key                                                                   ' Ключ агрегирования
        key = childPN & "|" & docType                                             ' PartNumber + тип документа
        If docType = "ProductDocument" And gRepeatingSubassemblies = True Then    ' Если это подсборка и нужно разворачивать повторы
            key = key & "|" & CStr(i)                                            ' Делаем ключ уникальным для каждого вхождения
        End If                                                                     ' Конец проверки раскрутки подсборок

        If dictQty.Exists(key) Then                                               ' Если позиция уже встречалась
            dictQty(key) = CLng(dictQty(key)) + 1                                 ' Увеличиваем количество
        Else                                                                      ' Если встретили впервые
            dictQty.Add key, 1                                                    ' Запоминаем qty=1
            dictFirst.Add key, child                                              ' Запоминаем объект (для Definition и т.п.)
            dictDocType.Add key, docType                                          ' Запоминаем тип документа

            ' --- Классификация позиции для порядка вывода ---                    ' Пояснение
            If docType = "ProductDocument" Then                                   ' Если это подсборка
                ordASM = ArrayAppendValue(ordASM, key)                            ' Добавляем в список подсборок
            ElseIf docType = "PartDocument" Then                                  ' Если это деталь

                Dim defText                                                       ' Definition детали
                defText = SafeGetDefinition(child)                                ' Берём Definition

                Dim isFast                                                        ' Флаг “крепёж”
                isFast = IsFastener(childPN, defText)                             ' Проверяем DIN/ОСТ/ДИН/OST

                If isFast = True Then                                             ' Если крепёж
                    ordFAST = ArrayAppendValue(ordFAST, key)                      ' В крепёж
                Else                                                              ' Иначе — не крепёж

                    Dim flagSgte                                                   ' Флаг “SGTE/СГТЕ” (имя НЕ конфликтует с функцией IsSGTE)
                    flagSgte = IsSGTE(childPN)                                     ' Вызываем функцию IsSGTE и получаем True/False

                    If flagSgte = True Then                                        ' Если это деталь SGTE/СГТЕ
                        ordSGTE = ArrayAppendValue(ordSGTE, key)                   ' Добавляем позицию в список “SGTE”
                    Else                                                           ' Иначе — это ПКИ
                        ordPKI = ArrayAppendValue(ordPKI, key)                     ' Добавляем позицию в список “ПКИ”
                    End If                                                         ' Конец ветвления SGTE/PKI

                End If                                                             ' Конец ветвления Fastener/обычный

            Else                                                                   ' Неизвестный тип документа
                ordPKI = ArrayAppendValue(ordPKI, key)                             ' Считаем как ПКИ (чтобы не потерять)
            End If                                                                 ' Конец классификации

        End If                                                                     ' Конец Exists
    Next                                                                           ' Следующий ребёнок

    ' ---- Вывод в нужном порядке: 1) подсборки 2) SGTE 3) крепёж 4) ПКИ ----      ' Пояснение
    sumMassEach = sumMassEach + EmitGroup(ordASM, "ASM", parentProd, parentPN, depth, dictQty, dictFirst, dictDocType, lines, matMassDict)   ' Подсборки
    sumMassEach = sumMassEach + EmitGroup(ordSGTE, "SGTE", parentProd, parentPN, depth, dictQty, dictFirst, dictDocType, lines, matMassDict) ' Детали SGTE
    sumMassEach = sumMassEach + EmitGroup(ordFAST, "FAST", parentProd, parentPN, depth, dictQty, dictFirst, dictDocType, lines, matMassDict) ' Крепёж
    sumMassEach = sumMassEach + EmitGroup(ordPKI, "PKI", parentProd, parentPN, depth, dictQty, dictFirst, dictDocType, lines, matMassDict)   ' ПКИ

    Call AppendMaterialLines(lines, matMassDict, depth + 1, parentPN)             ' Выводим накопленные материалы под текущую подсборку

    ProcessNodeCollect = sumMassEach                                               ' Возвращаем массу 1 шт узла

End Function                                                                       ' Конец ProcessNodeCollect


' -----------------------------                                                    ' Раздел комментария
' Вывод одной группы (ASM/SGTE/FAST/PKI)                                           ' Описание
' Возвращает вклад массы в родительскую сборку (учитывая qty)                      ' Описание
' -----------------------------                                                    ' Раздел комментария
Function EmitGroup(orderKeys, mode, parentProd, parentPN, depth, dictQty, dictFirst, dictDocType, ByRef lines, ByRef matMassDict)

    Dim addMass                                                                    ' Суммарная масса, которую добавит эта группа
    addMass = 0                                                                    ' Начинаем с 0

    Dim i                                                                          ' Счётчик по ключам группы
    For i = 0 To ArrayLastIndex(orderKeys)                                         ' Перебираем ключи

        Dim key                                                                    ' Ключ позиции
        key = orderKeys(i)                                                         ' Берём key

        Dim qty                                                                    ' Количество позиции в родителе
        qty = CLng(dictQty(key))                                                   ' Берём qty

        Dim childObj                                                               ' “Первый объект” позиции
        Set childObj = dictFirst(key)                                              ' Получаем объект

        Dim docType                                                                ' Тип документа позиции
        docType = CStr(dictDocType(key))                                           ' Берём тип

        Dim thisPN                                                                 ' PartNumber позиции
        thisPN = SafeGetPartNumber(childObj)                                       ' Берём PartNumber

        Dim thisDef                                                                ' Definition позиции
        thisDef = SafeGetDefinition(childObj)                                      ' Берём Definition
        Dim thisDesc                                                               ' Description позиции (для кода/БЧ)
        thisDesc = SafeGetDescription(childObj)                                    ' Берём Description отдельно от Definition

        If docType = "ProductDocument" Then                                        ' Если подсборка

            Dim asmLineIndex                                                       ' Индекс строки подсборки в payload
            asmLineIndex = AppendLineReturnIndex(lines, MakeTSVLine(depth + 1, "ASM", thisPN, thisPN, thisDef, parentPN, qty, DetectCode("ASM", thisDesc), "", "", 0, 0)) ' Добавляем строку подсборки (массу пересчитаем)

            Dim asmMassEach                                                        ' Масса 1 шт подсборки
            asmMassEach = ProcessNodeCollect(childObj, thisPN, depth + 1, lines)   ' Рекурсивно обрабатываем подсборку

            lines(asmLineIndex) = MakeTSVLine(depth + 1, "ASM", thisPN, thisPN, thisDef, parentPN, qty, "сб", "", "", asmMassEach, asmMassEach * qty) ' Перезаписываем строку с массой

            addMass = addMass + (asmMassEach * qty)                                ' Добавляем вклад в массу родителя

        ElseIf docType = "PartDocument" Then                                       ' Если деталь

            If mode = "FAST" Then                                                  ' Если крепёж

                Dim fastMassEachMeasured                                            ' Замеренная масса одной штуки
                Dim fastMassTotalCalc                                               ' Замеренная масса с учётом qty
                Dim fastMassEachOut                                                 ' Масса для вывода в таблицу (может быть пустой)
                Dim fastMassTotalOut                                                ' Итоговая масса для вывода (может быть пустой)
                fastMassEachMeasured = Empty                                        ' По умолчанию нет массы
                fastMassTotalCalc = Empty                                           ' По умолчанию нет итога
                fastMassEachOut = Empty                                             ' Вывод по умолчанию пуст
                fastMassTotalOut = Empty                                            ' Вывод по умолчанию пуст

                Dim fastPartDoc                                                     ' Документ крепежа
                On Error Resume Next                                                ' Перехват доступа
                Set fastPartDoc = childObj.ReferenceProduct.Parent                  ' Пытаемся открыть документ детали
                If Err.Number = 0 Then                                              ' Если документ доступен
                    Dim tmpMat                                                      ' Временный материал (не выводим)
                    Call MeasurePartMaterialAndMass(fastPartDoc, tmpMat, fastMassEachMeasured) ' Замеряем массу одной штуки
                    If Not IsEmpty(fastMassEachMeasured) Then                       ' Если масса замерилась
                        fastMassTotalCalc = CDbl(fastMassEachMeasured) * qty        ' Считаем итоговую массу по количеству
                    End If
                End If
                On Error GoTo 0                                                     ' Возвращаем обработку ошибок

                If gMassOfStandardParts = True Then                                 ' Если нужно отображать массу крепежа
                    fastMassEachOut = fastMassEachMeasured                          ' Пишем массу одной штуки
                    fastMassTotalOut = fastMassTotalCalc                            ' Пишем итоговую массу
                End If

                AppendLineReturnIndex lines, MakeTSVLine(depth + 1, "FAST", "крепеж", thisPN, thisDef, parentPN, qty, DetectCode("FAST", thisDesc, ""), "", "", fastMassEachOut, fastMassTotalOut) ' Строка крепежа
                If Not IsEmpty(fastMassTotalCalc) Then                              ' Если масса посчитана
                    addMass = addMass + CDbl(fastMassTotalCalc)                     ' Всегда учитываем массу в сборке
                End If

            ElseIf mode = "PKI" Then                                               ' Если ПКИ

                ' ВАЖНО: для ПКИ НЕ заполняем N, O, P, Q в Excel.                   ' Пояснение
                ' Поэтому в payload отправляем пустые TypeN/MaterialO и Empty по массам, чтобы не попадал текст "ПКИ". ' Пояснение
                Dim pkiMassEachMeasured                                             ' Замеренная масса одной единицы ПКИ
                Dim pkiMassTotalCalc                                                ' Масса всей позиции ПКИ
                Dim pkiMassEachOut                                                  ' Масса для вывода
                Dim pkiMassTotalOut                                                 ' Итоговая масса для вывода
                pkiMassEachMeasured = Empty                                         ' По умолчанию пусто
                pkiMassTotalCalc = Empty                                            ' По умолчанию пусто
                pkiMassEachOut = Empty                                              ' По умолчанию не выводим
                pkiMassTotalOut = Empty                                             ' По умолчанию не выводим

                Dim pkiPartDoc                                                     ' Документ ПКИ
                On Error Resume Next                                               ' Перехват ошибок доступа
                Set pkiPartDoc = childObj.ReferenceProduct.Parent                  ' Пытаемся открыть документ ПКИ
                If Err.Number = 0 Then                                             ' Если доступно
                    Dim tmpMatPki                                                  ' Временный материал
                    Call MeasurePartMaterialAndMass(pkiPartDoc, tmpMatPki, pkiMassEachMeasured) ' Замеряем массу ПКИ
                    If Not IsEmpty(pkiMassEachMeasured) Then                       ' Если масса получена
                        pkiMassTotalCalc = CDbl(pkiMassEachMeasured) * qty         ' Считаем итоговую массу по количеству
                    End If
                End If
                On Error GoTo 0                                                    ' Возврат обработки ошибок

                If gMassOfPKI = True Then                                          ' Если надо показывать массу ПКИ
                    pkiMassEachOut = pkiMassEachMeasured                           ' Пишем массу единицы
                    pkiMassTotalOut = pkiMassTotalCalc                             ' Пишем общую массу
                End If

                AppendLineReturnIndex lines, MakeTSVLine(depth + 1, "PKI", "ПКИ", thisPN, thisDef, parentPN, qty, DetectCode("PKI", thisDesc, ""), "", "", pkiMassEachOut, pkiMassTotalOut) ' Строка ПКИ
                If Not IsEmpty(pkiMassTotalCalc) Then                              ' Если масса посчитана
                    addMass = addMass + CDbl(pkiMassTotalCalc)                     ' Учитываем массу в сборке
                End If

            Else                                                                   ' Обычная деталь (SGTE/прочее)

                Dim partDoc                                                        ' Документ детали
                Set partDoc = childObj.ReferenceProduct.Parent                     ' Получаем PartDocument

                Dim partMat                                                        ' Материал детали
                Dim partMassEach                                                   ' Масса 1 шт детали
                Call MeasurePartMaterialAndMass(partDoc, partMat, partMassEach)    ' Измеряем материал и массу

                Dim typeN                                                          ' Класс материала для столбца N (Металл/Композит/Неметалл)
                typeN = GuessCompMetalPlusFoam(partMat)                            ' Классифицируем материал по библиотекам

                Dim codeValue                                                      ' Код для столбца M
                codeValue = DetectCode("PART", thisDesc, typeN)

                Dim hidePartAsMaterial                                             ' Флаг: скрыть деталь и заменить материалом
                hidePartAsMaterial = ShouldHideNonDrawingPart(thisDesc, partMat)

                If hidePartAsMaterial = True Then                                  ' Если БЧ-ткань и включена настройка

                    Call AccumulateMaterialMass(matMassDict, partMat, partMassEach * qty) ' Накопить массу материала внутри подсборки

                Else

                    AppendLineReturnIndex lines, MakeTSVLine(depth + 1,"PART",thisPN,thisPN,thisDef,parentPN,qty,codeValue,typeN,partMat,partMassEach,partMassEach * qty)                                            ' MassTotalKg (столбец Q)

                End If

                addMass = addMass + (partMassEach * qty)                           ' Добавляем вклад в массу родителя даже если деталь скрыта

            End If                                                                 ' Конец ветвления FAST/PKI/PART

        Else                                                                       ' Если тип неизвестный
            AppendLineReturnIndex lines, MakeTSVLine(depth + 1, "UNKNOWN", thisPN, thisPN, thisDef, parentPN, qty, "", "", "", 0, 0) ' Пишем строку “как есть”
        End If                                                                     ' Конец ветвления по типу

    Next                                                                           ' Следующий ключ

    EmitGroup = addMass                                                            ' Возвращаем суммарный вклад массы

End Function                                                                       ' Конец EmitGroup


' -----------------------------                                                    ' Раздел комментария
' Измерение материала и массы детали (по твёрдым Body)                             ' Описание
' -----------------------------                                                    ' Раздел комментария
Sub MeasurePartMaterialAndMass(partDoc, ByRef partMat, ByRef partMassEach)        ' Возвращает материал и массу

    partDoc.Activate                                                               ' Активируем документ детали (важно для SPAWorkbench)

    Dim oPart                                                                      ' Объект Part
    Set oPart = partDoc.Part                                                       ' Берём Part

    On Error Resume Next                                                           ' Перехват на случай проблем обновления
    oPart.Update                                                                   ' Обновляем модель
    On Error GoTo 0                                                                ' Снимаем перехват

    partMassEach = 0                                                               ' Масса детали = 0 по умолчанию
    partMat = ""                                                                   ' Материал детали пустой по умолчанию

    Dim bestMat                                                                    ' Первый найденный материал (если не сможем точно)
    bestMat = ""                                                                   ' Инициализация

    Dim b                                                                          ' Счётчик Body
    For b = 1 To oPart.Bodies.Count                                                ' Перебираем все Body

        Dim oBody                                                                  ' Текущий Body
        Set oBody = oPart.Bodies.Item(b)                                           ' Берём Body

        Dim meas                                                                   ' Результат измерения
        meas = MeasureBodyMass(oPart, partDoc, oBody)                              ' Пробуем измерить массу твёрдого Body

        If IsEmpty(meas) Then                                                      ' Если не твёрдое тело
            ' Пропускаем                                                          ' Пояснение
        Else
            partMassEach = partMassEach + CDbl(meas)                               ' Суммируем массу по твёрдым телам

            Dim mi                                                                 ' Материал как Array(name, density, source)
            mi = ResolveMaterialAllWays(partDoc, oPart, oBody)                     ' Ищем материал на Body/Part/и т.д.

            If Trim(CStr(mi(0))) <> "" Then                                        ' Если имя материала найдено
                If bestMat = "" Then                                               ' Если ещё не запоминали материал
                    bestMat = CStr(mi(0))                                          ' Запоминаем первый найденный
                End If                                                             ' Конец bestMat пустой?
            End If                                                                 ' Конец "материал найден?"
        End If                                                                     ' Конец "твёрдое тело?"

    Next                                                                           ' Следующий Body

    ' Итоговый материал детали:                                                    ' Пояснение
    ' 1) если на уровне Part/продукта есть материал — берём его, иначе первый найденный по Body
    Dim miPart                                                                     ' Материал на уровне Part/Product
    miPart = ResolveMaterialAllWays(partDoc, oPart, Nothing)                       ' Ищем материал без Body

    If Trim(CStr(miPart(0))) <> "" Then                                            ' Если нашли на уровне Part/Product
        partMat = CStr(miPart(0))                                                  ' Берём его
    Else                                                                           ' Если на уровне Part/Product нет
        partMat = bestMat                                                          ' Используем первый найденный по Body
    End If                                                                         ' Конец выбора итогового материала

End Sub                                                                            ' Конец MeasurePartMaterialAndMass


' -----------------------------                                                    ' Раздел комментария
' Измерение массы Body (если твёрдое тело)                                         ' Описание
' Возвращает массу (кг) или Empty                                                  ' Описание
' -----------------------------                                                    ' Раздел комментария
Function MeasureBodyMass(oPart, partDoc, oBody)

    Dim spa                                                                         ' SPAWorkbench
    Set spa = partDoc.GetWorkbench("SPAWorkbench")                                 ' Получаем верстак измерений

    Dim inertia                                                                     ' Inertia объект
    Set inertia = Nothing                                                           ' Инициализация

    On Error Resume Next                                                            ' Перехват
    Set inertia = spa.Inertias.Add(oBody)                                           ' Создаём инерцию по Body
    On Error GoTo 0                                                                 ' Снимаем перехват

    If inertia Is Nothing Then                                                      ' Если инерцию создать не удалось
        MeasureBodyMass = Empty                                                     ' Считаем, что измерение невозможно
        Exit Function                                                               ' Выходим
    End If                                                                          ' Конец проверки inertia

    Dim m                                                                           ' Масса
    m = 0                                                                           ' По умолчанию 0
    On Error Resume Next                                                            ' Перехват
    m = inertia.Mass                                                                ' Берём массу (кг)
    On Error GoTo 0                                                                 ' Снимаем

    ' Фильтр “твёрдого тела”: если масса <= 0 — считаем, что это не solid           ' Пояснение
    If CDbl(m) <= 0 Then                                                            ' Если масса не определилась
        MeasureBodyMass = Empty                                                     ' Возвращаем Empty
        Exit Function                                                               ' Выходим
    End If                                                                          ' Конец фильтра массы

    MeasureBodyMass = CDbl(m)                                                       ' Возвращаем массу

End Function                                                                        ' Конец MeasureBodyMass


' -----------------------------                                                    ' Раздел комментария
' Материал: ищем максимально широко                                                 ' Описание
' -----------------------------                                                    ' Раздел комментария
Function ResolveMaterialAllWays(partDoc, oPart, oBody)

    Dim mgr                                                                         ' Менеджер материалов
    Set mgr = GetMaterialManager(partDoc)                                           ' Получаем CATMatManagerVBExt

    Dim mat                                                                         ' Объект материала
    Set mat = Nothing                                                               ' Инициализация

    ' 1) Material на Body                                                           ' Пояснение
    If Not (oBody Is Nothing) Then                                                  ' Если Body передан
        If Not (mgr Is Nothing) Then                                                ' Если менеджер доступен
            On Error Resume Next                                                    ' Перехват
            mgr.GetMaterialOnBody oBody, mat                                        ' Пытаемся получить материал
            On Error GoTo 0                                                         ' Снимаем
            If Not (mat Is Nothing) Then                                            ' Если нашли
                ResolveMaterialAllWays = Array(mat.Name, 0, "Body")                 ' Возвращаем имя
                Exit Function                                                       ' Выходим
            End If                                                                  ' Конец проверки mat
        End If                                                                      ' Конец проверки mgr
    End If                                                                          ' Конец проверки oBody

    ' 2) Material на MainBody                                                       ' Пояснение
    If Not (mgr Is Nothing) Then                                                    ' Если менеджер доступен
        Dim mainB                                                                   ' MainBody
        Set mainB = Nothing                                                         ' Инициализация
        On Error Resume Next                                                         ' Перехват
        Set mainB = oPart.MainBody                                                  ' Берём главный Body
        On Error GoTo 0                                                              ' Снимаем перехват
        If Not (mainB Is Nothing) Then                                              ' Если MainBody есть
            Set mat = Nothing                                                       ' Обнуляем mat
            On Error Resume Next                                                    ' Перехват
            mgr.GetMaterialOnBody mainB, mat                                        ' Пытаемся получить материал
            On Error GoTo 0                                                         ' Снимаем
            If Not (mat Is Nothing) Then                                            ' Если нашли
                ResolveMaterialAllWays = Array(mat.Name, 0, "MainBody")             ' Возвращаем имя
                Exit Function                                                       ' Выходим
            End If                                                                  ' Конец проверки mat
        End If                                                                      ' Конец проверки mainB
    End If                                                                          ' Конец проверки mgr

    ' 3) Material на Part (если метод есть)                                         ' Пояснение
    If Not (mgr Is Nothing) Then                                                    ' Если менеджер доступен
        Set mat = Nothing                                                           ' Обнуляем mat
        On Error Resume Next                                                        ' Перехват
        mgr.GetMaterialOnPart oPart, mat                                            ' Пытаемся получить материал
        On Error GoTo 0                                                             ' Снимаем
        If Not (mat Is Nothing) Then                                                ' Если нашли
            ResolveMaterialAllWays = Array(mat.Name, 0, "Part")                     ' Возвращаем имя
            Exit Function                                                           ' Выходим
        End If                                                                      ' Конец проверки mat
    End If                                                                          ' Конец проверки mgr

    ' 4) Material на Product внутри CATPart                                         ' Пояснение
    If Not (mgr Is Nothing) Then                                                    ' Если менеджер доступен
        Set mat = Nothing                                                           ' Обнуляем mat
        On Error Resume Next                                                        ' Перехват
        mgr.GetMaterialOnProduct partDoc.Product, mat                               ' Пытаемся получить материал
        On Error GoTo 0                                                             ' Снимаем
        If Not (mat Is Nothing) Then                                                ' Если нашли
            ResolveMaterialAllWays = Array(mat.Name, 0, "Product")                  ' Возвращаем имя
            Exit Function                                                           ' Выходим
        End If                                                                      ' Конец проверки mat
    End If                                                                          ' Конец проверки mgr

    ' 5) Параметр Material/Материал                                                 ' Пояснение
    Dim pm                                                                          ' Переменная для параметра
    Set pm = TryFindMaterialParameter(partDoc)                                      ' Пытаемся найти параметр материала
    If Not (pm Is Nothing) Then                                                     ' Если параметр найден
        Dim valStr                                                                  ' Строковое значение параметра
        valStr = ""                                                                ' Инициализация
        On Error Resume Next                                                        ' Перехват
        valStr = pm.ValueAsString                                                   ' Читаем как строку
        On Error GoTo 0                                                             ' Снимаем перехват
        ResolveMaterialAllWays = Array(valStr, 0, "Parameter")                      ' Возвращаем значение
        Exit Function                                                               ' Выходим
    End If                                                                          ' Конец проверки параметра

    ResolveMaterialAllWays = Array("", 0, "NotFound")                               ' Если нигде не нашли — возвращаем пусто

End Function                                                                        ' Конец ResolveMaterialAllWays


Function GetMaterialManager(partDoc)

    Dim mgr                                                                         ' Переменная для менеджера материалов
    Set mgr = Nothing                                                               ' Инициализация

    On Error Resume Next                                                            ' Перехват ошибок
    Set mgr = partDoc.Part.GetItem("CATMatManagerVBExt")                            ' Пытаемся получить менеджер из Part
    If Err.Number <> 0 Or mgr Is Nothing Then                                       ' Если не получилось
        Err.Clear                                                                  ' Сбрасываем ошибку
        Set mgr = partDoc.Product.GetItem("CATMatManagerVBExt")                     ' Пытаемся получить менеджер из Product
    End If                                                                          ' Конец фолбэка
    On Error GoTo 0                                                                 ' Снимаем перехват

    Set GetMaterialManager = mgr                                                    ' Возвращаем менеджер (или Nothing)

End Function                                                                        ' Конец GetMaterialManager


Function TryFindMaterialParameter(partDoc)

    Dim params                                                                      ' Коллекция параметров Part
    Set params = partDoc.Part.Parameters                                            ' Берём параметры

    Dim names                                                                       ' Массив возможных имён параметра материала
    names = Array("Material", "MATERIAL", "Материал", "МАТЕРИАЛ", "Mat", "MAT")     ' Перечень вариантов имён

    Dim i                                                                           ' Счётчик
    For i = 0 To UBound(names)                                                      ' Перебираем варианты имён
        Dim p                                                                       ' Параметр
        Set p = Nothing                                                             ' Инициализация
        On Error Resume Next                                                        ' Перехват
        Set p = params.Item(names(i))                                               ' Пытаемся получить параметр по имени
        On Error GoTo 0                                                             ' Снимаем перехват
        If Not (p Is Nothing) Then                                                  ' Если нашли
            Set TryFindMaterialParameter = p                                        ' Возвращаем найденный параметр
            Exit Function                                                           ' Выходим
        End If                                                                      ' Конец проверки p
    Next                                                                            ' Следующий вариант имени

    Set TryFindMaterialParameter = Nothing                                          ' Если не нашли — возвращаем Nothing

End Function                                                                        ' Конец TryFindMaterialParameter


' -----------------------------                                                    ' Раздел комментария
' Definition: берём Definition, иначе Nomenclature/Name                             ' Описание
' -----------------------------                                                    ' Раздел комментария
Function SafeGetDefinition(prodObj)

    Dim s                                                                           ' Строка результата
    s = ""                                                                         ' Инициализация

    On Error Resume Next                                                           ' Перехват
    s = prodObj.ReferenceProduct.Definition                                        ' Пытаемся взять Definition у референса
    If Err.Number <> 0 Or Trim(s) = "" Then                                        ' Если не получилось или пусто
        Err.Clear                                                                  ' Сбрасываем ошибку
        s = prodObj.Definition                                                     ' Пытаемся взять Definition у экземпляра
    End If                                                                         ' Конец фолбэка
    On Error GoTo 0                                                                ' Снимаем перехват

    If Trim(s) = "" Then                                                           ' Если всё ещё пусто
        s = SafeGetNomenclature(prodObj)                                            ' Фолбэк на Nomenclature/Name
    End If                                                                         ' Конец проверки пустоты

    SafeGetDefinition = s                                                          ' Возвращаем итог

End Function                                                                        ' Конец SafeGetDefinition


Function SafeGetDescription(prodObj)

    Dim s                                                                           ' Строка результата
    s = ""                                                                         ' Инициализация

    On Error Resume Next                                                           ' Перехватываем ошибки доступа к свойствам
    s = prodObj.ReferenceProduct.Description                                       ' Прямое свойство Description
    If Err.Number <> 0 Then
        Err.Clear
        s = ""
    End If

    If Trim(s) = "" Then
        s = SafeReadUserProperty(prodObj.ReferenceProduct, "Description")          ' Пробуем пользовательское свойство
    End If
    If Trim(s) = "" Then
        s = SafeReadUserProperty(prodObj, "Description")                          ' Фолбэк на экземпляр
    End If
    If Trim(s) = "" Then
        s = SafeReadUserProperty(prodObj, "DESCRIPTION")                          ' Пробуем верхний регистр
    End If

    On Error GoTo 0                                                                 ' Возвращаем обычный режим
    SafeGetDescription = CStr(s)                                                    ' Возвращаем строку

End Function                                                                        ' Конец SafeGetDescription


Function SafeReadUserProperty(obj, propName)

    Dim val                                                                        ' Результат
    val = ""

    On Error Resume Next
    Dim props
    Set props = obj.UserRefProperties
    If Err.Number = 0 Then
        Dim item
        Set item = props.Item(propName)
        If Err.Number = 0 Then
            val = item.Value
        End If
    End If
    On Error GoTo 0

    SafeReadUserProperty = CStr(val)

End Function                                                                        ' Конец SafeReadUserProperty


Function SafeGetPartNumber(prodObj)

    Dim s                                                                           ' Строка результата
    s = ""                                                                         ' Инициализация
    On Error Resume Next                                                           ' Перехват
    s = prodObj.ReferenceProduct.PartNumber                                         ' Пытаемся взять PartNumber у референса
    If Err.Number <> 0 Or Trim(s) = "" Then                                        ' Если не получилось или пусто
        Err.Clear                                                                  ' Сбрасываем
        s = prodObj.PartNumber                                                     ' Пытаемся взять PartNumber у экземпляра
    End If                                                                         ' Конец фолбэка
    On Error GoTo 0                                                                ' Снимаем перехват
    SafeGetPartNumber = s                                                          ' Возвращаем

End Function                                                                        ' Конец SafeGetPartNumber


Function SafeGetNomenclature(prodObj)

    Dim s                                                                           ' Строка результата
    s = ""                                                                         ' Инициализация
    On Error Resume Next                                                           ' Перехват
    s = prodObj.ReferenceProduct.Nomenclature                                      ' Пытаемся взять Nomenclature у референса
    If Err.Number <> 0 Or Trim(s) = "" Then                                        ' Если не получилось/пусто
        Err.Clear                                                                  ' Сбрасываем
        s = prodObj.ReferenceProduct.Name                                          ' Фолбэк на Name референса
    End If                                                                         ' Конец фолбэка
    If Err.Number <> 0 Or Trim(s) = "" Then                                        ' Если всё ещё не получилось
        Err.Clear                                                                  ' Сбрасываем
        s = prodObj.Name                                                           ' Фолбэк на Name экземпляра
    End If                                                                         ' Конец второго фолбэка
    On Error GoTo 0                                                                ' Снимаем перехват
    SafeGetNomenclature = s                                                        ' Возвращаем

End Function                                                                        ' Конец SafeGetNomenclature


' -----------------------------                                                    ' Раздел комментария
' Классификация                                                                     ' Описание
' -----------------------------                                                    ' Раздел комментария
Function IsSGTE(partNumber)

    Dim s                                                                           ' Нормализованная строка
    s = LCase(Trim(CStr(partNumber)))                                              ' Приводим к нижнему регистру и обрезаем

    Dim idx                                                                         ' Индекс по массиву кодов
    For idx = LBound(gProjectCodes) To UBound(gProjectCodes)                       ' Перебираем все коды проекта
        Dim prefix                                                                  ' Очередной префикс из настроек
        prefix = LCase(Trim(CStr(gProjectCodes(idx))))                              ' Нормализуем префикс
        If prefix <> "" Then                                                       ' Пропускаем пустые
            If Left(s, Len(prefix)) = prefix Then                                   ' Сравниваем начало PartNumber с префиксом
                IsSGTE = True                                                      ' Нашли совпадение
                Exit Function                                                      ' Выходим сразу
            End If                                                                 ' Конец проверки совпадения
        End If                                                                     ' Конец проверки пустоты префикса
    Next                                                                           ' Следующий код проекта

    IsSGTE = False                                                                 ' Если не нашли ни одного совпадения — False

End Function                                                                        ' Конец IsSGTE


Function IsFastener(partNumber, defText)

    Dim s                                                                           ' Строка для поиска
    s = LCase(CStr(partNumber) & " " & CStr(defText))                              ' Склеиваем и приводим к нижнему регистру

    If InStr(s, "din") > 0 Then                                                    ' Англ. DIN
        IsFastener = True                                                          ' Это крепёж
    ElseIf InStr(s, "ост") > 0 Then                                                ' Рус. ОСТ
        IsFastener = True                                                          ' Это крепёж
    ElseIf InStr(s, "ost") > 0 Then                                                ' Англ. OST
        IsFastener = True                                                          ' Это крепёж
    ElseIf InStr(s, "дин") > 0 Then                                                ' Рус. ДИН
        IsFastener = True                                                          ' Это крепёж
    Else                                                                           ' Иначе
        IsFastener = False                                                         ' Не крепёж
    End If                                                                         ' Конец ветвления

End Function                                                                        ' Конец IsFastener


Function IsFabricOrCarbonByMaterial(materialName)

    Dim s                                                                           ' Нормализованная строка
    s = LCase(Trim(CStr(materialName)))                                            ' Нижний регистр + Trim

    IsFabricOrCarbonByMaterial = IsFabricMaterial(s)                               ' Используем словарь армирования/тканей из файла

End Function                                                                        ' Конец IsFabricOrCarbonByMaterial


' -----------------------------                                                    ' Раздел комментария
' Класс материала для столбца N                                                     ' Описание
' Возвращает: "Металл" / "Композит" / "Неметалл" / ""                               ' Описание
' -----------------------------                                                    ' Раздел комментария
Function GuessCompMetalPlusFoam(materialName)

    Dim s                                                                           ' Нормализованная строка материала
    s = LCase(Trim(CStr(materialName)))                                            ' Приводим к нижнему регистру и убираем пробелы

    If s = "" Then                                                                 ' Если материал не задан/не найден
        GuessCompMetalPlusFoam = ""                                                ' Возвращаем пусто (чтобы было видно, что материал не определён)
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки пустого материала

    If IsCompositeByKeywords(s) Then                                               ' Проверяем словарь композитов
        GuessCompMetalPlusFoam = "Композит"                                        ' Возвращаем "Композит"
        Exit Function
    End If

    If IsMetalByKeywords(s) Then                                                   ' Проверяем словарь металлов
        GuessCompMetalPlusFoam = "Металл"                                          ' Возвращаем "Металл"
        Exit Function
    End If

    GuessCompMetalPlusFoam = "Неметалл"                                            ' Если не попали в словари — считаем неметаллом

End Function                                                                        ' Конец GuessCompMetalPlusFoam


Function IsMetalByKeywords(materialLower)

    On Error Resume Next
    Dim lb, ub
    lb = LBound(gMetalMarks)
    If Err.Number <> 0 Then
        Err.Clear
        On Error GoTo 0
        IsMetalByKeywords = False
        Exit Function
    End If
    ub = UBound(gMetalMarks)
    On Error GoTo 0

    Dim i
    For i = lb To ub
        If Trim(CStr(gMetalMarks(i))) <> "" Then
            If InStr(materialLower, LCase(CStr(gMetalMarks(i)))) > 0 Then
                IsMetalByKeywords = True
                Exit Function
            End If
        End If
    Next

    IsMetalByKeywords = False

End Function                                                                        ' Конец IsMetalByKeywords


Function IsCompositeByKeywords(materialLower)

    On Error Resume Next
    Dim lb, ub
    lb = LBound(gCompositeKeywords)
    If Err.Number <> 0 Then
        Err.Clear
        On Error GoTo 0
        IsCompositeByKeywords = False
        Exit Function
    End If
    ub = UBound(gCompositeKeywords)
    On Error GoTo 0

    Dim i
    For i = lb To ub
        Dim item
        item = gCompositeKeywords(i)
        Dim kw
        kw = CStr(item(1))
        Dim mode
        mode = LCase(CStr(item(2)))
        If mode = "regex" Then
            Dim re
            Set re = CreateObject("VBScript.RegExp")
            re.IgnoreCase = True
            re.Global = False
            re.Pattern = kw
            If re.Test(materialLower) Then
                IsCompositeByKeywords = True
                Exit Function
            End If
        Else
            If InStr(materialLower, kw) > 0 Then
                IsCompositeByKeywords = True
                Exit Function
            End If
        End If
    Next

    IsCompositeByKeywords = False

End Function                                                                        ' Конец IsCompositeByKeywords


Function IsFabricMaterial(materialLower)

    On Error Resume Next
    Dim lb, ub
    lb = LBound(gFabricKeywords)
    If Err.Number <> 0 Then
        Err.Clear
        On Error GoTo 0
        IsFabricMaterial = False
        Exit Function
    End If
    ub = UBound(gFabricKeywords)
    On Error GoTo 0

    Dim i
    For i = lb To ub
        Dim item
        item = gFabricKeywords(i)
        Dim kw
        kw = CStr(item(1))
        Dim mode
        mode = LCase(CStr(item(2)))
        If mode = "regex" Then
            Dim re
            Set re = CreateObject("VBScript.RegExp")
            re.IgnoreCase = True
            re.Global = False
            re.Pattern = kw
            If re.Test(materialLower) Then
                IsFabricMaterial = True
                Exit Function
            End If
        Else
            If InStr(materialLower, kw) > 0 Then
                IsFabricMaterial = True
                Exit Function
            End If
        End If
    Next

    IsFabricMaterial = False

End Function                                                                        ' Конец IsFabricMaterial


Function DetectCode(kindValue, descriptionText, Optional typeNValue)

    Dim descLower
    descLower = LCase(CStr(descriptionText))

    If InStr(descLower, "бч") > 0 Then                                             ' БЧ всегда в приоритете
        DetectCode = "бч"
        Exit Function
    End If

    Dim descRules
    descRules = gCodeRules("descRules")
    Dim i
    For i = LBound(descRules) To UBound(descRules)
        Dim rule
        rule = descRules(i)
        Dim kw
        kw = CStr(rule(0))
        Dim code
        code = CStr(rule(1))
        If kw <> "бч" Then
            If InStr(descLower, kw) > 0 Then
                DetectCode = code
                Exit Function
            End If
        End If
    Next

    If UCase(kindValue) = "PART" Then                                              ' Дополнительные правила только для деталей
        If LCase(Trim(CStr(typeNValue))) = "композит" Then                         ' Если материал классифицирован как композит
            If gCodeRules.Exists("base_comp") Then                                 ' Если в Code.tsv указан код для композитов
                If Trim(CStr(gCodeRules("base_comp"))) <> "" Then                 ' И код не пустой
                    DetectCode = gCodeRules("base_comp")                          ' Используем код композита
                    Exit Function                                                   ' Завершаем поиск кода
                End If
            End If
        End If
    End If

    Select Case UCase(kindValue)
        Case "ASM"
            DetectCode = gCodeRules("base_asm")
        Case "FAST"
            DetectCode = gCodeRules("base_fast")
        Case "PKI"
            DetectCode = gCodeRules("base_pki")
        Case "MAT"
            DetectCode = gCodeRules("base_mat")
        Case Else
            DetectCode = gCodeRules("base_part")
    End Select

End Function                                                                        ' Конец DetectCode


Function ShouldHideNonDrawingPart(descriptionText, materialName)

    If gNonDrawingPartsAsMaterials = False Then
        ShouldHideNonDrawingPart = False
        Exit Function
    End If

    Dim descLower
    descLower = LCase(CStr(descriptionText))
    If InStr(descLower, "бч") = 0 Then
        ShouldHideNonDrawingPart = False
        Exit Function
    End If

    Dim matLower
    matLower = LCase(CStr(materialName))
    ShouldHideNonDrawingPart = IsFabricMaterial(matLower)

End Function                                                                        ' Конец ShouldHideNonDrawingPart


Sub AccumulateMaterialMass(ByRef matDict, materialName, massValue)

    Dim key                                                                        ' Ключ словаря = имя материала
    key = Trim(CStr(materialName))                                                 ' Обрезаем пробелы
    If key = "" Then                                                               ' Если имя пустое
        Exit Sub                                                                   ' Накопление не требуется
    End If                                                                         ' Конец проверки пустоты

    Dim massKg                                                                    ' Масса в килограммах
    On Error Resume Next                                                           ' Перехватываем возможные ошибки приведения
    massKg = CDbl(massValue)                                                       ' Пробуем привести к Double
    If Err.Number <> 0 Then                                                        ' Если приведение не удалось
        Err.Clear                                                                  ' Чистим ошибку
        On Error GoTo 0                                                            ' Возвращаем обработку
        Exit Sub                                                                   ' Выходим без накопления
    End If                                                                         ' Конец проверки ошибки
    On Error GoTo 0                                                                ' Возвращаем обработку ошибок

    If matDict.Exists(key) Then                                                    ' Если материал уже есть в словаре
        matDict(key) = CDbl(matDict(key)) + massKg                                 ' Прибавляем массу
    Else                                                                           ' Если материала ещё не было
        matDict.Add key, massKg                                                    ' Создаём запись
    End If                                                                         ' Конец ветвления

End Sub                                                                             ' Конец AccumulateMaterialMass


Sub AppendMaterialLines(ByRef lines, ByRef matDict, depth, parentPN)

    Dim key                                                                        ' Ключ словаря
    For Each key In matDict.Keys                                                   ' Перебираем все материалы
        Dim massKg                                                                ' Масса материала в килограммах
        massKg = CDbl(matDict(key))                                                ' Берём накопленную массу
        If massKg <> 0 Then                                                        ' Пустые массы не выводим
            AppendLineReturnIndex lines, MakeTSVLine(depth, "MAT", "материал", key, key, parentPN, massKg, DetectCode("MAT", "", ""), "", key, massKg, massKg) ' Вставляем строку материала
        End If                                                                    ' Конец проверки массы
    Next                                                                           ' Следующий материал

End Sub                                                                             ' Конец AppendMaterialLines


' -----------------------------                                                    ' Раздел комментария
' Payload TSV                                                                       ' Описание
' -----------------------------                                                    ' Раздел комментария
Function MakeTSVLine(depth, kind, label, partNumber, defText, parentPN, qty, codeM, typeN, materialO, massEach, massTotal)

    MakeTSVLine = _
        CStr(depth) & vbTab & _
        CleanTSV(kind) & vbTab & _
        CleanTSV(label) & vbTab & _
        CleanTSV(partNumber) & vbTab & _
        CleanTSV(defText) & vbTab & _
        CleanTSV(parentPN) & vbTab & _
        CStr(qty) & vbTab & _
        CleanTSV(codeM) & vbTab & _
        CleanTSV(typeN) & vbTab & _
        CleanTSV(materialO) & vbTab & _
        Replace(CStr(massEach), ",", ".") & vbTab & _
        Replace(CStr(massTotal), ",", ".")

End Function                                                                        ' Конец MakeTSVLine


Function CleanTSV(s)

    Dim t                                                                           ' Рабочая строка
    t = CStr(s)                                                                    ' Приводим к строке
    t = Replace(t, vbTab, " ")                                                     ' Убираем табуляции (ломают TSV)
    t = Replace(t, vbCr, " ")                                                      ' Убираем CR
    t = Replace(t, vbLf, " ")                                                      ' Убираем LF
    CleanTSV = Trim(t)                                                             ' Возвращаем Trim

End Function                                                                        ' Конец CleanTSV


Function AppendLineReturnIndex(ByRef arr, line)

    Dim ub                                                                          ' Индекс последнего элемента
    ub = ArrayLastIndex(arr)                                                        ' Получаем последний индекс

    If ub = -1 Then                                                                ' Если массив пуст
        ReDim arr(0)                                                               ' Создаём массив из 1 элемента
        arr(0) = line                                                              ' Пишем строку
        AppendLineReturnIndex = 0                                                  ' Возвращаем индекс 0
    Else                                                                           ' Если массив не пуст
        ReDim Preserve arr(ub + 1)                                                 ' Увеличиваем массив на 1
        arr(ub + 1) = line                                                         ' Пишем новую строку
        AppendLineReturnIndex = ub + 1                                             ' Возвращаем индекс добавленного элемента
    End If                                                                         ' Конец ветвления

End Function                                                                        ' Конец AppendLineReturnIndex


' -----------------------------                                                    ' Раздел комментария
' Файлы/папки/строки                                                                 ' Описание
' -----------------------------                                                    ' Раздел комментария
Function WriteAllTextUnicode(path, text)

    On Error Resume Next                                                           ' Перехват ошибок записи
    Dim fso                                                                        ' FileSystemObject
    Set fso = CreateObject("Scripting.FileSystemObject")                           ' Создаём FSO
    Dim f                                                                          ' Файл
    Set f = fso.CreateTextFile(path, True, True)                                   ' True=overwrite, True=Unicode (UTF-16 LE)
    f.Write text                                                                   ' Пишем текст
    f.Close                                                                        ' Закрываем файл
    If Err.Number <> 0 Then                                                        ' Если ошибка
        Err.Clear                                                                  ' Сбрасываем
        WriteAllTextUnicode = False                                                ' Возвращаем False
    Else                                                                           ' Если без ошибок
        WriteAllTextUnicode = True                                                 ' Возвращаем True
    End If                                                                         ' Конец ветвления
    On Error GoTo 0                                                                ' Снимаем перехват

End Function                                                                        ' Конец WriteAllTextUnicode


Function FileExists(path)

    Dim fso                                                                        ' FileSystemObject
    Set fso = CreateObject("Scripting.FileSystemObject")                           ' Создаём FSO
    FileExists = fso.FileExists(path)                                              ' Проверяем существование

End Function                                                                        ' Конец FileExists


Function ReadTextFileUtf8Safe(path)

    Dim fso                                                                        ' FileSystemObject для чтения файла
    Set fso = CreateObject("Scripting.FileSystemObject")                           ' Создаём FSO

    If fso.FileExists(path) = False Then                                           ' Если файла нет
        ReadTextFileUtf8Safe = ""                                                  ' Возвращаем пустую строку
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки файла

    Dim ts                                                                         ' Текстовый поток
    Set ts = fso.OpenTextFile(path, 1, False)                                      ' Открываем на чтение (кодировка по умолчанию системы)
    ReadTextFileUtf8Safe = ts.ReadAll                                              ' Читаем весь файл
    ts.Close                                                                       ' Закрываем поток

End Function                                                                        ' Конец ReadTextFileUtf8Safe


Function DefaultProjectCodes()

    Dim arr                                                                        ' Массив по умолчанию
    arr = Array("СГТЕ", "SGTE")                                                    ' Базовые коды проекта (кириллица/латиница)
    DefaultProjectCodes = arr                                                      ' Возвращаем массив

End Function                                                                        ' Конец DefaultProjectCodes


Sub LoadMaterialLibraries(folderPath)

    ' --- Металлы ---
    Dim metalsPath
    metalsPath = folderPath & "\metals_ru_library.tsv"
    Dim metalContent
    metalContent = ReadTextFileUtf8Safe(metalsPath)
    Dim metalList()
    ReDim metalList(-1)
    If Trim(metalContent) <> "" Then
        Dim metalLines
        metalLines = Split(metalContent, vbCrLf)
        Dim i
        For i = 1 To UBound(metalLines)                                            ' Пропускаем заголовок
            Dim ln
            ln = Trim(metalLines(i))
            If ln <> "" Then
                Dim cols
                cols = Split(ln, vbTab)
                If UBound(cols) >= 1 Then
                    Dim mark
                    mark = Trim(cols(1))
                    Dim idx
                    idx = ArrayLastIndex(metalList) + 1
                    ReDim Preserve metalList(idx)
                    metalList(idx) = mark
                End If
            End If
        Next
    End If
    gMetalMarks = metalList

    ' --- Композиты/армирование ---
    Dim compPath
    compPath = folderPath & "\composites_detect_keywords.tsv"
    Dim compContent
    compContent = ReadTextFileUtf8Safe(compPath)
    Dim compList()
    Dim fabricList()
    ReDim compList(-1)
    ReDim fabricList(-1)
    If Trim(compContent) <> "" Then
        Dim compLines
        compLines = Split(compContent, vbCrLf)
        Dim j
        For j = 1 To UBound(compLines)                                             ' Пропускаем заголовок
            Dim cln
            cln = Trim(compLines(j))
            If cln <> "" Then
                Dim ccols
                ccols = Split(cln, vbTab)
                If UBound(ccols) >= 2 Then
                    Dim grp
                    grp = LCase(Trim(ccols(0)))
                    Dim tag
                    tag = LCase(Trim(ccols(1)))
                    Dim mode
                    mode = LCase(Trim(ccols(2)))

                    Dim idxComp
                    idxComp = ArrayLastIndex(compList) + 1
                    ReDim Preserve compList(idxComp)
                    compList(idxComp) = Array(grp, tag, mode)

                    If InStr(grp, "армир") > 0 Then
                        Dim idxFab
                        idxFab = ArrayLastIndex(fabricList) + 1
                        ReDim Preserve fabricList(idxFab)
                        fabricList(idxFab) = Array(grp, tag, mode)
                    End If
                End If
            End If
        Next
    End If
    gCompositeKeywords = compList
    gFabricKeywords = fabricList

End Sub                                                                            ' Конец LoadMaterialLibraries


Function LoadSettings(settingsPath, ByRef projectCodes, ByRef repeatSubassemblies, ByRef nonDrawingAsMaterials, ByRef massStd, ByRef massPki)

    Dim fso                                                                      ' Объект файловой системы для проверки
    Set fso = CreateObject("Scripting.FileSystemObject")                         ' Создаём FSO

    If fso.FileExists(settingsPath) = False Then                                  ' Если Settings.txt отсутствует
        MsgBox "Не найден Settings.txt рядом с сохраняемым Excel. Положи файл настроек в папку: " & vbCrLf & _
               GetFolderFromFullPath(settingsPath), vbExclamation, "BOM Extract"  ' Показываем понятное сообщение
        LoadSettings = False                                                       ' Возвращаем False
        Exit Function                                                              ' Прерываем загрузку
    End If                                                                         ' Конец проверки наличия файла

    Dim content                                                                   ' Содержимое файла настроек
    content = ReadTextFileUtf8Safe(settingsPath)                                  ' Пробуем прочитать текст

    If Trim(content) = "" Then                                                    ' Если файл пустой
        LoadSettings = True                                                        ' Считаем загрузку успешной (используем дефолты)
        Exit Function                                                              ' Возвращаемся
    End If                                                                        ' Конец проверки содержимого

    Dim lines                                                                     ' Массив строк файла
    lines = Split(content, vbCrLf)                                                ' Делим по переводам строк

    Dim i                                                                        ' Счётчик строк
    For i = LBound(lines) To UBound(lines)                                        ' Перебираем каждую строку

        Dim line                                                                 ' Текущая строка
        line = Trim(lines(i))                                                     ' Обрезаем пробелы

        If line <> "" Then                                                        ' Пустые строки пропускаем

            Dim posEq                                                            ' Позиция знака '='
            posEq = InStr(line, "=")                                             ' Ищем '='

            If posEq > 0 Then                                                     ' Если нашли

                Dim key                                                          ' Имя настройки
                key = Trim(Left(line, posEq - 1))                                 ' Берём часть до '='

                Dim valueRaw                                                      ' Необработанное значение
                valueRaw = Trim(Mid(line, posEq + 1))                             ' Берём часть после '='

                Select Case LCase(key)                                           ' Смотрим имя настройки
                    Case "project_code"                                         ' Настройка кодов проекта

                        valueRaw = Replace(valueRaw, "'", "")                   ' Убираем кавычки
                        valueRaw = Replace(valueRaw, "\"", "")                 ' Убираем обратные слэши
                        valueRaw = Replace(valueRaw, " or ", ",", 1, -1, vbTextCompare) ' Заменяем "or" на запятую

                        Dim parts                                                ' Части списка
                        parts = Split(valueRaw, ",")                             ' Делим по запятой

                        Dim cleaned()                                            ' Очищенный список
                        Dim c                                                    ' Счётчик очищенных
                        c = -1                                                    ' Начинаем с -1 для ReDim Preserve

                        Dim j                                                    ' Счётчик по частям
                        For j = LBound(parts) To UBound(parts)                    ' Перебираем элементы
                            Dim item                                             ' Элемент списка
                            item = Trim(parts(j))                                ' Trim каждого элемента
                            If item <> "" Then                                  ' Пропускаем пустые
                                c = c + 1                                        ' Увеличиваем счётчик
                                ReDim Preserve cleaned(c)                        ' Расширяем массив
                                cleaned(c) = item                                ' Кладём значение
                            End If                                               ' Конец проверки пустоты
                        Next                                                     ' Следующий элемент

                        If c >= 0 Then                                           ' Если собрали хоть одно значение
                            projectCodes = cleaned                               ' Подменяем глобальный список
                        End If                                                   ' Конец проверки количества

                    Case "repeating_subassemblies_in_tree"                      ' Флаг разворачивать подсборки

                        repeatSubassemblies = (LCase(valueRaw) = "true")        ' True если явно указано true

                    Case "non-drawing_parts_as_materials"                      ' Флаг БЧ-тканей как материалов

                        nonDrawingAsMaterials = (LCase(valueRaw) = "true")      ' True если явно указано true

                    Case "mass_of_standard_parts"                              ' Показывать массу стандартных изделий

                        massStd = (LCase(valueRaw) = "true")                   ' True если явно указано true

                    Case "mass_of_pki"                                         ' Показывать массу ПКИ

                        massPki = (LCase(valueRaw) = "true")                   ' True если явно указано true

                End Select                                                       ' Конец выбора по ключу

            End If                                                               ' Конец проверки на '='

        End If                                                                   ' Конец проверки пустой строки

    Next                                                                         ' Следующая строка настроек

    LoadSettings = True                                                          ' Успешно разобрали файл настроек

End Function                                                                     ' Конец LoadSettings


Function LoadCodeRules(codePath)

    Dim rules
    Set rules = CreateObject("Scripting.Dictionary")

    rules.Add "base_asm", "сб"                                                      ' Значение по умолчанию для сборок
    rules.Add "base_part", "д"                                                     ' Значение по умолчанию для деталей
    rules.Add "base_fast", "креп"                                                  ' Значение по умолчанию для крепежа
    rules.Add "base_pki", "пок"                                                    ' Значение по умолчанию для ПКИ (если нет кода — возьмём пок для закупок)
    rules.Add "base_mat", "мат"                                                    ' Значение по умолчанию для материалов
    rules.Add "base_comp", ""                                                      ' Отдельный код для композитов (может отсутствовать)

    Dim descRules()
    ReDim descRules(-1)

    Dim content
    content = ReadTextFileUtf8Safe(codePath)

    If Trim(content) <> "" Then
        Dim lines
        lines = Split(content, vbCrLf)
        Dim i
        For i = LBound(lines) To UBound(lines)
            Dim ln
            ln = Trim(lines(i))
            If ln <> "" Then
                Dim cols
                cols = Split(ln, vbTab)
                If UBound(cols) >= 1 Then
                    Dim code
                    code = Trim(cols(0))
                    Dim label
                    label = LCase(Trim(cols(1)))
                    Dim isDesc
                    isDesc = False
                    If UBound(cols) >= 2 Then
                        isDesc = (LCase(Trim(cols(2))) = "description")
                    End If

                    If InStr(label, "сборка") > 0 Then
                        rules("base_asm") = code
                    ElseIf InStr(label, "деталь") > 0 Then
                        rules("base_part") = code
                    ElseIf InStr(label, "креп") > 0 Then
                        rules("base_fast") = code
                    ElseIf InStr(label, "пки") > 0 Or InStr(label, "покуп") > 0 Then
                        rules("base_pki") = code
                    ElseIf InStr(label, "материал") > 0 Then
                        rules("base_mat") = code
                    ElseIf InStr(label, "комп") > 0 Then
                        rules("base_comp") = code
                    End If

                    If isDesc = True Then
                        Dim idx
                        idx = ArrayLastIndex(descRules) + 1
                        ReDim Preserve descRules(idx)
                        descRules(idx) = Array(LCase(code), code)                 ' keyword=code, value=code
                    End If
                End If
            End If
        Next
    End If

    rules.Add "descRules", descRules
    Set LoadCodeRules = rules

End Function                                                                      ' Конец LoadCodeRules


Function GetFolderFromFullPath(fullPath)

    Dim fso                                                                        ' FileSystemObject
    Set fso = CreateObject("Scripting.FileSystemObject")                           ' Создаём FSO
    GetFolderFromFullPath = fso.GetParentFolderName(fullPath)                      ' Возвращаем родительскую папку

End Function                                                                        ' Конец GetFolderFromFullPath


Function Quote(s)

    Quote = Chr(34) & s & Chr(34)                                                  ' Оборачиваем строку в кавычки для командной строки

End Function                                                                        ' Конец Quote


Function ParseStartLevel(s)

    Dim t                                                                          ' Рабочая строка
    t = UCase(Trim(CStr(s)))                                                       ' Нормализуем

    If Left(t, 1) = "G" Then                                                       ' Если начинается с G
        t = Mid(t, 2)                                                              ' Отбрасываем G
    End If                                                                         ' Конец обработки G

    If IsNumeric(t) Then                                                           ' Если остался номер
        ParseStartLevel = CLng(t)                                                  ' Возвращаем число
    Else                                                                           ' Иначе
        ParseStartLevel = -1                                                       ' Ошибка парсинга
    End If                                                                         ' Конец ветвления

End Function                                                                        ' Конец ParseStartLevel


' -----------------------------                                                    ' Раздел комментария
' Массивы                                                                            ' Описание
' -----------------------------                                                    ' Раздел комментария
Function ArrayLastIndex(arr)

    On Error Resume Next                                                           ' Перехват (если массив пустой)
    Dim ub                                                                         ' UBound
    ub = UBound(arr)                                                               ' Пытаемся получить верхнюю границу
    If Err.Number <> 0 Then                                                        ' Если ошибка (массив пуст)
        Err.Clear                                                                  ' Сбрасываем
        ArrayLastIndex = -1                                                        ' Возвращаем -1
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец обработки ошибки
    On Error GoTo 0                                                                ' Снимаем перехват

    If ub < 0 Then                                                                 ' Если вдруг отрицательный
        ArrayLastIndex = -1                                                        ' Возвращаем -1
    Else                                                                           ' Иначе
        ArrayLastIndex = ub                                                        ' Возвращаем индекс
    End If                                                                         ' Конец ветвления

End Function                                                                        ' Конец ArrayLastIndex


Function ArrayAppendValue(arr, value)

    Dim ub                                                                         ' Индекс последнего элемента
    ub = ArrayLastIndex(arr)                                                       ' Получаем индекс

    If ub = -1 Then                                                                ' Если массив пустой
        ReDim arr(0)                                                               ' Создаём 1 элемент
        arr(0) = value                                                             ' Записываем value
    Else                                                                           ' Если массив не пустой
        ReDim Preserve arr(ub + 1)                                                 ' Увеличиваем на 1
        arr(ub + 1) = value                                                        ' Записываем value
    End If                                                                         ' Конец ветвления

    ArrayAppendValue = arr                                                         ' Возвращаем обновлённый массив

End Function                                                                        ' Конец ArrayAppendValue
