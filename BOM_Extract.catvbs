                isFast = IsFastener(childPN, defText)                             ' Проверяем DIN/ОСТ/ДИН/OST

                If isFast = True Then                                             ' Если крепёж
                    ordFAST = ArrayAppendValue(ordFAST, key)                      ' В крепёж
                Else                                                              ' Иначе — не крепёж

                    Dim flagSgte                                                   ' Флаг “SGTE/СГТЕ” (имя НЕ конфликтует с функцией IsSGTE)
                    flagSgte = IsSGTE(childPN)                                     ' Вызываем функцию IsSGTE и получаем True/False
@@ -198,96 +227,150 @@ End Function
Function EmitGroup(orderKeys, mode, parentProd, parentPN, depth, dictQty, dictFirst, dictDocType, ByRef lines)

    Dim addMass                                                                    ' Суммарная масса, которую добавит эта группа
    addMass = 0                                                                    ' Начинаем с 0

    Dim i                                                                          ' Счётчик по ключам группы
    For i = 0 To ArrayLastIndex(orderKeys)                                         ' Перебираем ключи

        Dim key                                                                    ' Ключ позиции
        key = orderKeys(i)                                                         ' Берём key

        Dim qty                                                                    ' Количество позиции в родителе
        qty = CLng(dictQty(key))                                                   ' Берём qty

        Dim childObj                                                               ' “Первый объект” позиции
        Set childObj = dictFirst(key)                                              ' Получаем объект

        Dim docType                                                                ' Тип документа позиции
        docType = CStr(dictDocType(key))                                           ' Берём тип

        Dim thisPN                                                                 ' PartNumber позиции
        thisPN = SafeGetPartNumber(childObj)                                       ' Берём PartNumber

        Dim thisDef                                                                ' Definition позиции
        thisDef = SafeGetDefinition(childObj)                                      ' Берём Definition
        Dim thisDesc                                                               ' Description позиции (для кода/БЧ)
        thisDesc = SafeGetDescription(childObj)                                    ' Берём Description отдельно от Definition

        If docType = "ProductDocument" Then                                        ' Если подсборка

            Dim asmLineIndex                                                       ' Индекс строки подсборки в payload
            asmLineIndex = AppendLineReturnIndex(lines, MakeTSVLine(depth + 1, "ASM", thisPN, thisPN, thisDef, parentPN, qty, "сб", "", "", 0, 0)) ' Добавляем строку подсборки (массу пересчитаем)
            asmLineIndex = AppendLineReturnIndex(lines, MakeTSVLine(depth + 1, "ASM", thisPN, thisPN, thisDef, parentPN, qty, DetectCode("ASM", thisDesc), "", "", 0, 0)) ' Добавляем строку подсборки (массу пересчитаем)

            Dim asmMassEach                                                        ' Масса 1 шт подсборки
            asmMassEach = ProcessNodeCollect(childObj, thisPN, depth + 1, lines)   ' Рекурсивно обрабатываем подсборку

            lines(asmLineIndex) = MakeTSVLine(depth + 1, "ASM", thisPN, thisPN, thisDef, parentPN, qty, "сб", "", "", asmMassEach, asmMassEach * qty) ' Перезаписываем строку с массой

            addMass = addMass + (asmMassEach * qty)                                ' Добавляем вклад в массу родителя

        ElseIf docType = "PartDocument" Then                                       ' Если деталь

            If mode = "FAST" Then                                                  ' Если крепёж

                ' ВАЖНО: для крепежа НЕ заполняем N, O, P, Q в Excel.               ' Пояснение
                ' Поэтому в payload отправляем пустые TypeN/MaterialO и Empty по массам, чтобы не попадал текст "крепеж". ' Пояснение
                AppendLineReturnIndex lines, MakeTSVLine(depth + 1, "FAST", "крепеж", thisPN, thisDef, parentPN, qty, "крепеж", "", "", Empty, Empty)
                Dim fastMassEach                                                     ' Масса 1 шт крепежа (может остаться пустой)
                Dim fastMassTotal                                                    ' Масса всего крепежа в позиции (qty * mass)
                fastMassEach = Empty                                                 ' По умолчанию оставляем пустым, если вывод массы выключен
                fastMassTotal = Empty                                                ' Итоговая масса тоже пустая по умолчанию
                If gMassOfStandardParts = True Then                                 ' Считаем массу крепежа только если флаг разрешён
                    Dim fastPartDoc                                                  ' Документ детали крепежа
                    On Error Resume Next                                             ' Перехватываем ошибку, если документ не загружен
                    Set fastPartDoc = childObj.ReferenceProduct.Parent              ' Пытаемся получить PartDocument крепежа
                    If Err.Number = 0 Then                                          ' Если документ получили без ошибок
                        Dim tmpMat                                                   ' Временная переменная для материала (не используется далее)
                        Call MeasurePartMaterialAndMass(fastPartDoc, tmpMat, fastMassEach) ' Снимаем массу одной штуки через замер геометрии
                        fastMassTotal = CDbl(fastMassEach) * qty                    ' Умножаем массу одной штуки на количество в позиции
                    End If                                                           ' Конец проверки ошибки
                    On Error GoTo 0                                                  ' Возвращаем обычную обработку ошибок
                End If                                                               ' Конец блока расчёта массы крепежа

                AppendLineReturnIndex lines, MakeTSVLine(depth + 1, "FAST", "крепеж", thisPN, thisDef, parentPN, qty, DetectCode("FAST", thisDesc), "", "", fastMassEach, fastMassTotal)
                If Not IsEmpty(fastMassTotal) Then
                    addMass = addMass + CDbl(fastMassTotal)
                End If


                ' Массу крепежа не считаем                                          ' Пояснение

            ElseIf mode = "PKI" Then                                               ' Если ПКИ

                ' ВАЖНО: для ПКИ НЕ заполняем N, O, P, Q в Excel.                   ' Пояснение
                ' Поэтому в payload отправляем пустые TypeN/MaterialO и Empty по массам, чтобы не попадал текст "ПКИ". ' Пояснение
                AppendLineReturnIndex lines, MakeTSVLine(depth + 1, "PKI", "ПКИ", thisPN, thisDef, parentPN, qty, "ПКИ", "", "", Empty, Empty)
                Dim pkiMassEach                                                      ' Масса 1 шт ПКИ (может быть пустой при выключенном флаге)
                Dim pkiMassTotal                                                     ' Масса всей позиции ПКИ (qty * mass)
                pkiMassEach = Empty                                                  ' По умолчанию не выводим массу
                pkiMassTotal = Empty                                                 ' Итоговая масса тоже пустая
                If gMassOfPKI = True Then                                            ' Считаем массу только если разрешено настройкой
                    Dim pkiPartDoc                                                   ' Документ ПКИ
                    On Error Resume Next                                             ' Перехватываем возможные ошибки доступа
                    Set pkiPartDoc = childObj.ReferenceProduct.Parent               ' Пробуем получить PartDocument ПКИ
                    If Err.Number = 0 Then                                          ' Если документ доступен
                        Dim tmpMatPki                                                ' Временная переменная материала для совместимости с процедурой измерения
                        Call MeasurePartMaterialAndMass(pkiPartDoc, tmpMatPki, pkiMassEach) ' Замеряем массу одной штуки ПКИ
                        pkiMassTotal = CDbl(pkiMassEach) * qty                      ' Считаем массу всей позиции с учётом количества
                    End If                                                           ' Конец проверки ошибки
                    On Error GoTo 0                                                  ' Возвращаем стандартную обработку ошибок
                End If                                                               ' Конец блока расчёта массы ПКИ

                AppendLineReturnIndex lines, MakeTSVLine(depth + 1, "PKI", "ПКИ", thisPN, thisDef, parentPN, qty, DetectCode("PKI", thisDesc), "", "", pkiMassEach, pkiMassTotal)
                If Not IsEmpty(pkiMassTotal) Then
                    addMass = addMass + CDbl(pkiMassTotal)
                End If


                ' Массу ПКИ не считаем                                              ' Пояснение

            Else                                                                   ' Обычная деталь (SGTE/прочее)

                Dim partDoc                                                        ' Документ детали
                Set partDoc = childObj.ReferenceProduct.Parent                     ' Получаем PartDocument

                Dim partMat                                                        ' Материал детали
                Dim partMassEach                                                   ' Масса 1 шт детали
                Call MeasurePartMaterialAndMass(partDoc, partMat, partMassEach)    ' Измеряем материал и массу

                Dim typeN                                                          ' Класс материала для столбца N (Металл/Композит/Неметалл)
                typeN = GuessCompMetalPlusFoam(partMat)                            ' Классифицируем материал по ключевым словам (см. функцию ниже)
                typeN = GuessCompMetalPlusFoam(partMat)                            ' Классифицируем материал по библиотекам

                Dim codeValue                                                      ' Код для столбца M
                codeValue = DetectCode("PART", thisDesc)

                Dim hidePartAsMaterial                                             ' Флаг: скрыть деталь и заменить материалом
                hidePartAsMaterial = ShouldHideNonDrawingPart(thisDesc, partMat)

                If hidePartAsMaterial = True Then                                  ' Если БЧ-ткань и включена настройка

                    AppendLineReturnIndex lines, MakeTSVLine(depth + 1, "MAT", "материал", partMat, partMat, parentPN, partMassEach * qty, DetectCode("MAT", ""), "", partMat, partMassEach, partMassEach * qty) ' Строка материала вместо детали

                Else

                    AppendLineReturnIndex lines, MakeTSVLine(depth + 1,"PART",thisPN,thisPN,thisDef,parentPN,qty,codeValue,typeN,partMat,partMassEach,partMassEach * qty)                                            ' MassTotalKg (столбец Q)

                AppendLineReturnIndex lines, MakeTSVLine(depth + 1,"PART",thisPN,thisPN,thisDef,parentPN,qty,"дет",typeN,partMat,partMassEach,partMassEach * qty)                                            ' MassTotalKg (столбец Q)
                End If

                addMass = addMass + (partMassEach * qty)                           ' Добавляем вклад в массу родителя

            End If                                                                 ' Конец ветвления FAST/PKI/PART

        Else                                                                       ' Если тип неизвестный
            AppendLineReturnIndex lines, MakeTSVLine(depth + 1, "UNKNOWN", thisPN, thisPN, thisDef, parentPN, qty, "", "", "", 0, 0) ' Пишем строку “как есть”
        End If                                                                     ' Конец ветвления по типу

    Next                                                                           ' Следующий ключ

    EmitGroup = addMass                                                            ' Возвращаем суммарный вклад массы

End Function                                                                       ' Конец EmitGroup


