Option Explicit                                                                 ' Требуем явного объявления переменных (меньше “магических” ошибок)

Dim gProjectCodePrefixes                                                         ' Массив префиксов проекта (в нижнем регистре)
Dim gRepeatingSubassembliesInTree                                                ' Флаг: повторять подсборки в дереве (из Settings.txt)
Dim gNonDrawingPartsAsMaterials                                                  ' Флаг: скрывать БЧ-ткань как материалы (из Settings.txt)
Dim gMassOfStandardParts                                                         ' Флаг: показывать массу стандартных изделий (из Settings.txt)
Dim gMassOfPKI                                                                   ' Флаг: показывать массу ПКИ (из Settings.txt)

' -----------------------------                                                    ' Раздел комментария
' Точка входа макроса CATIA                                                        ' Описание
' -----------------------------                                                    ' Раздел комментария
Sub CATMain()                                                                     ' Главная процедура, которую вызывает CATIA

    Dim asmDoc                                                                    ' Переменная для активного документа
    Set asmDoc = CATIA.ActiveDocument                                             ' Берём текущий активный документ CATIA

    If TypeName(asmDoc) <> "ProductDocument" Then                                 ' Если активный документ не сборка (CATProduct)
        MsgBox "Открой активную сборку (CATProduct) и запусти макрос ещё раз.", vbExclamation, "BOM Extract" ' Сообщаем пользователю
        Exit Sub                                                                  ' Выходим из макроса
    End If                                                                        ' Конец проверки типа документа

    Dim rootProd                                                                  ' Переменная для корневого Product
    Set rootProd = asmDoc.Product                                                 ' Получаем корневой продукт сборки

    Dim startLevelText                                                            ' Строка ответа пользователя по стартовому уровню
    startLevelText = InputBox("С какого уровня начать в Excel? Введи: G1..G8 (например G2).", "BOM Extract", "G2") ' Просим уровень

    Dim startLevel                                                                ' Числовой стартовый уровень (1..8)
    startLevel = ParseStartLevel(startLevelText)                                  ' Парсим G1..G8 в число

    If startLevel < 1 Or startLevel > 8 Then                                      ' Если уровень невалиден
        MsgBox "Неверный уровень. Допустимо: G1..G8.", vbExclamation, "BOM Extract" ' Сообщаем
        Exit Sub                                                                  ' Выходим
    End If                                                                        ' Конец проверки уровня

    Dim outXlsx                                                                   ' Путь сохранения Excel
    outXlsx = CATIA.FileSelectionBox("Сохранить спецификацию как Excel", "*.xlsx", 1) ' Диалог “Сохранить как”
    If Trim(outXlsx) = "" Then                                                    ' Если пользователь нажал Cancel
        MsgBox "Сохранение отменено.", vbInformation, "BOM Extract"               ' Сообщаем
        Exit Sub                                                                  ' Выходим
    End If                                                                        ' Конец Cancel
    If LCase(Right(outXlsx, 5)) <> ".xlsx" Then                                   ' Если расширение не .xlsx
        outXlsx = outXlsx & ".xlsx"                                               ' Добавляем расширение
    End If                                                                        ' Конец проверки расширения

    Dim workFolder                                                                ' Папка, где лежат файлы
    workFolder = GetFolderFromFullPath(outXlsx)                                   ' Папка = папка выбранного Excel

    Dim builderPath                                                               ' Путь к ExcelBuilder
    builderPath = workFolder & "\ExcelBuilder.vbs"                                ' ExcelBuilder должен лежать рядом

    If FileExists(builderPath) = False Then                                       ' Если ExcelBuilder не найден
        MsgBox "Не найден ExcelBuilder.vbs в папке:" & vbCrLf & workFolder & vbCrLf & _
               "Положи ExcelBuilder.vbs рядом с тем местом, куда сохраняешь Excel.", vbExclamation, "BOM Extract" ' Подсказка
        Exit Sub                                                                  ' Выходим
    End If                                                                        ' Конец проверки ExcelBuilder

    If LoadSettingsFromFile(workFolder) = False Then                              ' Пробуем прочитать Settings.txt (A1)
        Exit Sub                                                                  ' Если не смогли — выходим
    End If                                                                        ' Конец проверки загрузки настроек

    Dim payloadPath                                                               ' Путь к промежуточному payload
    payloadPath = workFolder & "\BOM_payload.tsv"                                 ' Payload кладём рядом

    Dim lines                                                                     ' Массив строк payload
    lines = Array()                                                               ' Инициализируем пустым массивом

    ' Заголовок TSV (для ExcelBuilder)                                             ' Пояснение
    lines = ArrayAppendValue(lines, _
        "Depth" & vbTab & "Kind" & vbTab & "Label" & vbTab & "PartNumber" & vbTab & "Definition" & vbTab & _
        "ParentPN" & vbTab & "Qty" & vbTab & "CodeM" & vbTab & "TypeN" & vbTab & "MaterialO" & vbTab & _
        "MassEachKg" & vbTab & "MassTotalKg")                                     ' Столбцы payload (строго по порядку)

    Dim rootPN                                                                    ' PartNumber корня
    rootPN = SafeGetPartNumber(rootProd)                                          ' Берём PartNumber корневой сборки

    Dim rootDef                                                                   ' Definition корня
    rootDef = SafeGetDefinition(rootProd)                                         ' Берём Definition (fallback внутри)

    Dim rootLineIndex                                                             ' Индекс строки корня в массиве lines
    rootLineIndex = AppendLineReturnIndex(lines, MakeTSVLine(0, "ASM", rootPN, rootPN, rootDef, "", 1, "сб", "", "", 0, 0)) ' Пишем корень (масса позже)

    Dim rootMassEach                                                              ' Масса 1 шт корня
    rootMassEach = ProcessNodeCollect(rootProd, rootPN, 0, lines)                 ' Обходим дерево, заполняем lines, получаем массу корня

    lines(rootLineIndex) = MakeTSVLine(0, "ASM", rootPN, rootPN, rootDef, "", 1, "сб", "", "", rootMassEach, rootMassEach) ' Перезаписываем корень с массой

    If WriteAllTextUnicode(payloadPath, Join(lines, vbCrLf)) = False Then         ' Если не удалось записать файл
        MsgBox "Не удалось записать файл: " & payloadPath, vbExclamation, "BOM Extract" ' Сообщаем
        Exit Sub                                                                  ' Выходим
    End If                                                                        ' Конец проверки записи

    Dim cmd                                                                       ' Команда запуска ExcelBuilder
    cmd = "wscript.exe " & Quote(builderPath) & " " & Quote(payloadPath) & " " & Quote(outXlsx) & " " & CStr(startLevel) ' Передаём payload, xlsx и старт-уровень

    Dim sh                                                                        ' WScript.Shell для запуска
    Set sh = CreateObject("WScript.Shell")                                        ' Создаём shell
    sh.Run cmd, 1, True                                                           ' Запускаем и ждём завершения

    MsgBox "Готово." & vbCrLf & "Excel: " & outXlsx, vbInformation, "BOM Extract" ' Финальное сообщение

End Sub                                                                           ' Конец CATMain


' -----------------------------                                                    ' Раздел комментария
' Рекурсивная обработка узла (сборка)                                              ' Описание
' Возвращает массу 1 шт данного узла                                               ' Описание
' -----------------------------                                                    ' Раздел комментария
Function ProcessNodeCollect(parentProd, parentPN, depth, ByRef lines)             ' Рекурсивный обход

    Dim sumMassEach                                                               ' Масса 1 шт родителя = сумма масс детей
    sumMassEach = 0                                                               ' Начинаем с 0

    Dim dictQty                                                                   ' Словарь количества по позиции
    Set dictQty = CreateObject("Scripting.Dictionary")                            ' key -> qty

    Dim dictFirst                                                                 ' Словарь “первого объекта” для позиции
    Set dictFirst = CreateObject("Scripting.Dictionary")                          ' key -> child object

    Dim dictDocType                                                               ' Словарь типа документа для позиции
    Set dictDocType = CreateObject("Scripting.Dictionary")                        ' key -> "ProductDocument"/"PartDocument"/"Unknown"

    Dim ordASM, ordSGTE, ordFAST, ordPKI                                          ' Массивы порядка по группам
    ordASM = Array()                                                              ' Подсборки
    ordSGTE = Array()                                                             ' Детали проекта (по префиксам Project_code)
    ordFAST = Array()                                                             ' Крепёж (DIN/ОСТ)
    ordPKI = Array()                                                              ' ПКИ (прочие)

    Dim i                                                                         ' Счётчик детей
    For i = 1 To parentProd.Products.Count                                        ' Перебираем детей

        Dim child                                                                 ' Дочерний продукт (экземпляр)
        Set child = parentProd.Products.Item(i)                                   ' Берём ребёнка

        Dim refDoc                                                                ' Документ референса
        Set refDoc = Nothing                                                      ' Инициализация
        On Error Resume Next                                                      ' Перехват (если не загружено)
        Set refDoc = child.ReferenceProduct.Parent                                ' Пытаемся получить документ
        On Error GoTo 0                                                           ' Снимаем перехват

        Dim docType                                                               ' Тип документа
        docType = "Unknown"                                                       ' По умолчанию Unknown
        If Not (refDoc Is Nothing) Then                                           ' Если документ получен
            docType = TypeName(refDoc)                                            ' Тип документа
        End If                                                                    ' Конец проверки refDoc

        Dim childPN                                                               ' PartNumber ребёнка
        childPN = SafeGetPartNumber(child)                                        ' Берём PartNumber

        Dim key                                                                   ' Ключ агрегирования
        key = childPN & "|" & docType                                             ' PartNumber + тип документа

        If dictQty.Exists(key) Then                                               ' Если позиция уже встречалась
            dictQty(key) = CLng(dictQty(key)) + 1                                 ' Увеличиваем количество
        Else                                                                      ' Если встретили впервые
            dictQty.Add key, 1                                                    ' Запоминаем qty=1
            dictFirst.Add key, child                                              ' Запоминаем объект (для Definition и т.п.)
            dictDocType.Add key, docType                                          ' Запоминаем тип документа

            ' --- Классификация позиции для порядка вывода ---                    ' Пояснение
            If docType = "ProductDocument" Then                                   ' Если это подсборка
                ordASM = ArrayAppendValue(ordASM, key)                            ' Добавляем в список подсборок
            ElseIf docType = "PartDocument" Then                                  ' Если это деталь

                Dim defText                                                       ' Definition детали
                defText = SafeGetDefinition(child)                                ' Берём Definition

                Dim isFast                                                        ' Флаг “крепёж”
                isFast = IsFastener(childPN, defText)                             ' Проверяем DIN/ОСТ/ДИН/OST

                If isFast = True Then                                             ' Если крепёж
                    ordFAST = ArrayAppendValue(ordFAST, key)                      ' В крепёж
                Else                                                              ' Иначе — не крепёж

                Dim flagSgte                                                   ' Флаг “деталь проекта” по Project_code (имя НЕ конфликтует с функцией IsSGTE)
                    flagSgte = IsSGTE(childPN)                                     ' Вызываем функцию IsSGTE и получаем True/False

                    If flagSgte = True Then                                        ' Если это “своя” деталь по префиксам Project_code
                        ordSGTE = ArrayAppendValue(ordSGTE, key)                   ' Добавляем позицию в список “своих” деталей
                    Else                                                           ' Иначе — это ПКИ
                        ordPKI = ArrayAppendValue(ordPKI, key)                     ' Добавляем позицию в список “ПКИ”
                    End If                                                         ' Конец ветвления “свои детали”/ПКИ

                End If                                                             ' Конец ветвления Fastener/обычный

            Else                                                                   ' Неизвестный тип документа
                ordPKI = ArrayAppendValue(ordPKI, key)                             ' Считаем как ПКИ (чтобы не потерять)
            End If                                                                 ' Конец классификации

        End If                                                                     ' Конец Exists
    Next                                                                           ' Следующий ребёнок

    ' ---- Вывод в нужном порядке: 1) подсборки 2) детали проекта 3) крепёж 4) ПКИ ----      ' Пояснение
    sumMassEach = sumMassEach + EmitGroup(ordASM, "ASM", parentProd, parentPN, depth, dictQty, dictFirst, dictDocType, lines)   ' Подсборки
    sumMassEach = sumMassEach + EmitGroup(ordSGTE, "SGTE", parentProd, parentPN, depth, dictQty, dictFirst, dictDocType, lines) ' Детали проекта (по Project_code)
    sumMassEach = sumMassEach + EmitGroup(ordFAST, "FAST", parentProd, parentPN, depth, dictQty, dictFirst, dictDocType, lines) ' Крепёж
    sumMassEach = sumMassEach + EmitGroup(ordPKI, "PKI", parentProd, parentPN, depth, dictQty, dictFirst, dictDocType, lines)   ' ПКИ

    ProcessNodeCollect = sumMassEach                                               ' Возвращаем массу 1 шт узла

End Function                                                                       ' Конец ProcessNodeCollect


' -----------------------------                                                    ' Раздел комментария
' Вывод одной группы (ASM/Project/FAST/PKI)                                        ' Описание
' Возвращает вклад массы в родительскую сборку (учитывая qty)                      ' Описание
' -----------------------------                                                    ' Раздел комментария
Function EmitGroup(orderKeys, mode, parentProd, parentPN, depth, dictQty, dictFirst, dictDocType, ByRef lines)

    Dim addMass                                                                    ' Суммарная масса, которую добавит эта группа
    addMass = 0                                                                    ' Начинаем с 0

    Dim i                                                                          ' Счётчик по ключам группы
    For i = 0 To ArrayLastIndex(orderKeys)                                         ' Перебираем ключи

        Dim key                                                                    ' Ключ позиции
        key = orderKeys(i)                                                         ' Берём key

        Dim qty                                                                    ' Количество позиции в родителе
        qty = CLng(dictQty(key))                                                   ' Берём qty

        Dim childObj                                                               ' “Первый объект” позиции
        Set childObj = dictFirst(key)                                              ' Получаем объект

        Dim docType                                                                ' Тип документа позиции
        docType = CStr(dictDocType(key))                                           ' Берём тип

        Dim thisPN                                                                 ' PartNumber позиции
        thisPN = SafeGetPartNumber(childObj)                                       ' Берём PartNumber

        Dim thisDef                                                                ' Definition позиции
        thisDef = SafeGetDefinition(childObj)                                      ' Берём Definition

        If docType = "ProductDocument" Then                                        ' Если подсборка

            Dim asmLineIndex                                                       ' Индекс строки подсборки в payload
            asmLineIndex = AppendLineReturnIndex(lines, MakeTSVLine(depth + 1, "ASM", thisPN, thisPN, thisDef, parentPN, qty, "сб", "", "", 0, 0)) ' Добавляем строку подсборки (массу пересчитаем)

            Dim asmMassEach                                                        ' Масса 1 шт подсборки
            asmMassEach = ProcessNodeCollect(childObj, thisPN, depth + 1, lines)   ' Рекурсивно обрабатываем подсборку

            lines(asmLineIndex) = MakeTSVLine(depth + 1, "ASM", thisPN, thisPN, thisDef, parentPN, qty, "сб", "", "", asmMassEach, asmMassEach * qty) ' Перезаписываем строку с массой

            addMass = addMass + (asmMassEach * qty)                                ' Добавляем вклад в массу родителя

        ElseIf docType = "PartDocument" Then                                       ' Если деталь

            If mode = "FAST" Then                                                  ' Если крепёж

                ' ВАЖНО: для крепежа НЕ заполняем N, O, P, Q в Excel.               ' Пояснение
                ' Поэтому в payload отправляем пустые TypeN/MaterialO и Empty по массам, чтобы не попадал текст "крепеж". ' Пояснение
                AppendLineReturnIndex lines, MakeTSVLine(depth + 1, "FAST", "крепеж", thisPN, thisDef, parentPN, qty, "крепеж", "", "", Empty, Empty)


                ' Массу крепежа не считаем                                          ' Пояснение

            ElseIf mode = "PKI" Then                                               ' Если ПКИ

                ' ВАЖНО: для ПКИ НЕ заполняем N, O, P, Q в Excel.                   ' Пояснение
                ' Поэтому в payload отправляем пустые TypeN/MaterialO и Empty по массам, чтобы не попадал текст "ПКИ". ' Пояснение
                AppendLineReturnIndex lines, MakeTSVLine(depth + 1, "PKI", "ПКИ", thisPN, thisDef, parentPN, qty, "ПКИ", "", "", Empty, Empty)


                ' Массу ПКИ не считаем                                              ' Пояснение

            Else                                                                   ' Обычная деталь (по префиксам Project_code либо прочее)

                Dim partDoc                                                        ' Документ детали
                Set partDoc = childObj.ReferenceProduct.Parent                     ' Получаем PartDocument

                Dim partMat                                                        ' Материал детали
                Dim partMassEach                                                   ' Масса 1 шт детали
                Call MeasurePartMaterialAndMass(partDoc, partMat, partMassEach)    ' Измеряем материал и массу

                Dim typeN                                                          ' Класс материала для столбца N (Металл/Композит/Неметалл)
                typeN = GuessCompMetalPlusFoam(partMat)                            ' Классифицируем материал по ключевым словам (см. функцию ниже)

                AppendLineReturnIndex lines, MakeTSVLine(depth + 1,"PART",thisPN,thisPN,thisDef,parentPN,qty,"дет",typeN,partMat,partMassEach,partMassEach * qty)                                            ' MassTotalKg (столбец Q)

                addMass = addMass + (partMassEach * qty)                           ' Добавляем вклад в массу родителя

            End If                                                                 ' Конец ветвления FAST/PKI/PART

        Else                                                                       ' Если тип неизвестный
            AppendLineReturnIndex lines, MakeTSVLine(depth + 1, "UNKNOWN", thisPN, thisPN, thisDef, parentPN, qty, "", "", "", 0, 0) ' Пишем строку “как есть”
        End If                                                                     ' Конец ветвления по типу

    Next                                                                           ' Следующий ключ

    EmitGroup = addMass                                                            ' Возвращаем суммарный вклад массы

End Function                                                                       ' Конец EmitGroup


' -----------------------------                                                    ' Раздел комментария
' Измерение материала и массы детали (по твёрдым Body)                             ' Описание
' -----------------------------                                                    ' Раздел комментария
Sub MeasurePartMaterialAndMass(partDoc, ByRef partMat, ByRef partMassEach)        ' Возвращает материал и массу

    partDoc.Activate                                                               ' Активируем документ детали (важно для SPAWorkbench)

    Dim oPart                                                                      ' Объект Part
    Set oPart = partDoc.Part                                                       ' Берём Part

    On Error Resume Next                                                           ' Перехват на случай проблем обновления
    oPart.Update                                                                   ' Обновляем модель
    On Error GoTo 0                                                                ' Снимаем перехват

    partMassEach = 0                                                               ' Масса детали = 0 по умолчанию
    partMat = ""                                                                   ' Материал детали пустой по умолчанию

    Dim bestMat                                                                    ' Первый найденный материал (если не сможем точно)
    bestMat = ""                                                                   ' Инициализация

    Dim b                                                                          ' Счётчик Body
    For b = 1 To oPart.Bodies.Count                                                ' Перебираем все Body

        Dim oBody                                                                  ' Текущий Body
        Set oBody = oPart.Bodies.Item(b)                                           ' Берём Body

        Dim meas                                                                   ' Результат измерения
        meas = MeasureBodyMass(oPart, partDoc, oBody)                              ' Пробуем измерить массу твёрдого Body

        If IsEmpty(meas) Then                                                      ' Если не твёрдое тело
            ' Пропускаем                                                          ' Пояснение
        Else
            partMassEach = partMassEach + CDbl(meas)                               ' Суммируем массу по твёрдым телам

            Dim mi                                                                 ' Материал как Array(name, density, source)
            mi = ResolveMaterialAllWays(partDoc, oPart, oBody)                     ' Ищем материал на Body/Part/и т.д.

            If Trim(CStr(mi(0))) <> "" Then                                        ' Если имя материала найдено
                If bestMat = "" Then                                               ' Если ещё не запоминали материал
                    bestMat = CStr(mi(0))                                          ' Запоминаем первый найденный
                End If                                                             ' Конец bestMat пустой?
            End If                                                                 ' Конец "материал найден?"
        End If                                                                     ' Конец "твёрдое тело?"

    Next                                                                           ' Следующий Body

    ' Итоговый материал детали:                                                    ' Пояснение
    ' 1) если на уровне Part/продукта есть материал — берём его, иначе первый найденный по Body
    Dim miPart                                                                     ' Материал на уровне Part/Product
    miPart = ResolveMaterialAllWays(partDoc, oPart, Nothing)                       ' Ищем материал без Body

    If Trim(CStr(miPart(0))) <> "" Then                                            ' Если нашли на уровне Part/Product
        partMat = CStr(miPart(0))                                                  ' Берём его
    Else                                                                           ' Если на уровне Part/Product нет
        partMat = bestMat                                                          ' Используем первый найденный по Body
    End If                                                                         ' Конец выбора итогового материала

End Sub                                                                            ' Конец MeasurePartMaterialAndMass


' -----------------------------                                                    ' Раздел комментария
' Измерение массы Body (если твёрдое тело)                                         ' Описание
' Возвращает массу (кг) или Empty                                                  ' Описание
' -----------------------------                                                    ' Раздел комментария
Function MeasureBodyMass(oPart, partDoc, oBody)

    Dim spa                                                                         ' SPAWorkbench
    Set spa = partDoc.GetWorkbench("SPAWorkbench")                                 ' Получаем верстак измерений

    Dim inertia                                                                     ' Inertia объект
    Set inertia = Nothing                                                           ' Инициализация

    On Error Resume Next                                                            ' Перехват
    Set inertia = spa.Inertias.Add(oBody)                                           ' Создаём инерцию по Body
    On Error GoTo 0                                                                 ' Снимаем перехват

    If inertia Is Nothing Then                                                      ' Если инерцию создать не удалось
        MeasureBodyMass = Empty                                                     ' Считаем, что измерение невозможно
        Exit Function                                                               ' Выходим
    End If                                                                          ' Конец проверки inertia

    Dim m                                                                           ' Масса
    m = 0                                                                           ' По умолчанию 0
    On Error Resume Next                                                            ' Перехват
    m = inertia.Mass                                                                ' Берём массу (кг)
    On Error GoTo 0                                                                 ' Снимаем

    ' Фильтр “твёрдого тела”: если масса <= 0 — считаем, что это не solid           ' Пояснение
    If CDbl(m) <= 0 Then                                                            ' Если масса не определилась
        MeasureBodyMass = Empty                                                     ' Возвращаем Empty
        Exit Function                                                               ' Выходим
    End If                                                                          ' Конец фильтра массы

    MeasureBodyMass = CDbl(m)                                                       ' Возвращаем массу

End Function                                                                        ' Конец MeasureBodyMass


' -----------------------------                                                    ' Раздел комментария
' Материал: ищем максимально широко                                                 ' Описание
' -----------------------------                                                    ' Раздел комментария
Function ResolveMaterialAllWays(partDoc, oPart, oBody)

    Dim mgr                                                                         ' Менеджер материалов
    Set mgr = GetMaterialManager(partDoc)                                           ' Получаем CATMatManagerVBExt

    Dim mat                                                                         ' Объект материала
    Set mat = Nothing                                                               ' Инициализация

    ' 1) Material на Body                                                           ' Пояснение
    If Not (oBody Is Nothing) Then                                                  ' Если Body передан
        If Not (mgr Is Nothing) Then                                                ' Если менеджер доступен
            On Error Resume Next                                                    ' Перехват
            mgr.GetMaterialOnBody oBody, mat                                        ' Пытаемся получить материал
            On Error GoTo 0                                                         ' Снимаем
            If Not (mat Is Nothing) Then                                            ' Если нашли
                ResolveMaterialAllWays = Array(mat.Name, 0, "Body")                 ' Возвращаем имя
                Exit Function                                                       ' Выходим
            End If                                                                  ' Конец проверки mat
        End If                                                                      ' Конец проверки mgr
    End If                                                                          ' Конец проверки oBody

    ' 2) Material на MainBody                                                       ' Пояснение
    If Not (mgr Is Nothing) Then                                                    ' Если менеджер доступен
        Dim mainB                                                                   ' MainBody
        Set mainB = Nothing                                                         ' Инициализация
        On Error Resume Next                                                         ' Перехват
        Set mainB = oPart.MainBody                                                  ' Берём главный Body
        On Error GoTo 0                                                              ' Снимаем перехват
        If Not (mainB Is Nothing) Then                                              ' Если MainBody есть
            Set mat = Nothing                                                       ' Обнуляем mat
            On Error Resume Next                                                    ' Перехват
            mgr.GetMaterialOnBody mainB, mat                                        ' Пытаемся получить материал
            On Error GoTo 0                                                         ' Снимаем
            If Not (mat Is Nothing) Then                                            ' Если нашли
                ResolveMaterialAllWays = Array(mat.Name, 0, "MainBody")             ' Возвращаем имя
                Exit Function                                                       ' Выходим
            End If                                                                  ' Конец проверки mat
        End If                                                                      ' Конец проверки mainB
    End If                                                                          ' Конец проверки mgr

    ' 3) Material на Part (если метод есть)                                         ' Пояснение
    If Not (mgr Is Nothing) Then                                                    ' Если менеджер доступен
        Set mat = Nothing                                                           ' Обнуляем mat
        On Error Resume Next                                                        ' Перехват
        mgr.GetMaterialOnPart oPart, mat                                            ' Пытаемся получить материал
        On Error GoTo 0                                                             ' Снимаем
        If Not (mat Is Nothing) Then                                                ' Если нашли
            ResolveMaterialAllWays = Array(mat.Name, 0, "Part")                     ' Возвращаем имя
            Exit Function                                                           ' Выходим
        End If                                                                      ' Конец проверки mat
    End If                                                                          ' Конец проверки mgr

    ' 4) Material на Product внутри CATPart                                         ' Пояснение
    If Not (mgr Is Nothing) Then                                                    ' Если менеджер доступен
        Set mat = Nothing                                                           ' Обнуляем mat
        On Error Resume Next                                                        ' Перехват
        mgr.GetMaterialOnProduct partDoc.Product, mat                               ' Пытаемся получить материал
        On Error GoTo 0                                                             ' Снимаем
        If Not (mat Is Nothing) Then                                                ' Если нашли
            ResolveMaterialAllWays = Array(mat.Name, 0, "Product")                  ' Возвращаем имя
            Exit Function                                                           ' Выходим
        End If                                                                      ' Конец проверки mat
    End If                                                                          ' Конец проверки mgr

    ' 5) Параметр Material/Материал                                                 ' Пояснение
    Dim pm                                                                          ' Переменная для параметра
    Set pm = TryFindMaterialParameter(partDoc)                                      ' Пытаемся найти параметр материала
    If Not (pm Is Nothing) Then                                                     ' Если параметр найден
        Dim valStr                                                                  ' Строковое значение параметра
        valStr = ""                                                                ' Инициализация
        On Error Resume Next                                                        ' Перехват
        valStr = pm.ValueAsString                                                   ' Читаем как строку
        On Error GoTo 0                                                             ' Снимаем перехват
        ResolveMaterialAllWays = Array(valStr, 0, "Parameter")                      ' Возвращаем значение
        Exit Function                                                               ' Выходим
    End If                                                                          ' Конец проверки параметра

    ResolveMaterialAllWays = Array("", 0, "NotFound")                               ' Если нигде не нашли — возвращаем пусто

End Function                                                                        ' Конец ResolveMaterialAllWays


Function GetMaterialManager(partDoc)

    Dim mgr                                                                         ' Переменная для менеджера материалов
    Set mgr = Nothing                                                               ' Инициализация

    On Error Resume Next                                                            ' Перехват ошибок
    Set mgr = partDoc.Part.GetItem("CATMatManagerVBExt")                            ' Пытаемся получить менеджер из Part
    If Err.Number <> 0 Or mgr Is Nothing Then                                       ' Если не получилось
        Err.Clear                                                                  ' Сбрасываем ошибку
        Set mgr = partDoc.Product.GetItem("CATMatManagerVBExt")                     ' Пытаемся получить менеджер из Product
    End If                                                                          ' Конец фолбэка
    On Error GoTo 0                                                                 ' Снимаем перехват

    Set GetMaterialManager = mgr                                                    ' Возвращаем менеджер (или Nothing)

End Function                                                                        ' Конец GetMaterialManager


Function TryFindMaterialParameter(partDoc)

    Dim params                                                                      ' Коллекция параметров Part
    Set params = partDoc.Part.Parameters                                            ' Берём параметры

    Dim names                                                                       ' Массив возможных имён параметра материала
    names = Array("Material", "MATERIAL", "Материал", "МАТЕРИАЛ", "Mat", "MAT")     ' Перечень вариантов имён

    Dim i                                                                           ' Счётчик
    For i = 0 To UBound(names)                                                      ' Перебираем варианты имён
        Dim p                                                                       ' Параметр
        Set p = Nothing                                                             ' Инициализация
        On Error Resume Next                                                        ' Перехват
        Set p = params.Item(names(i))                                               ' Пытаемся получить параметр по имени
        On Error GoTo 0                                                             ' Снимаем перехват
        If Not (p Is Nothing) Then                                                  ' Если нашли
            Set TryFindMaterialParameter = p                                        ' Возвращаем найденный параметр
            Exit Function                                                           ' Выходим
        End If                                                                      ' Конец проверки p
    Next                                                                            ' Следующий вариант имени

    Set TryFindMaterialParameter = Nothing                                          ' Если не нашли — возвращаем Nothing

End Function                                                                        ' Конец TryFindMaterialParameter


' -----------------------------                                                    ' Раздел комментария
' Definition: берём Definition, иначе Nomenclature/Name                             ' Описание
' -----------------------------                                                    ' Раздел комментария
Function SafeGetDefinition(prodObj)

    Dim s                                                                           ' Строка результата
    s = ""                                                                         ' Инициализация

    On Error Resume Next                                                           ' Перехват
    s = prodObj.ReferenceProduct.Definition                                        ' Пытаемся взять Definition у референса
    If Err.Number <> 0 Or Trim(s) = "" Then                                        ' Если не получилось или пусто
        Err.Clear                                                                  ' Сбрасываем ошибку
        s = prodObj.Definition                                                     ' Пытаемся взять Definition у экземпляра
    End If                                                                         ' Конец фолбэка
    On Error GoTo 0                                                                ' Снимаем перехват

    If Trim(s) = "" Then                                                           ' Если всё ещё пусто
        s = SafeGetNomenclature(prodObj)                                            ' Фолбэк на Nomenclature/Name
    End If                                                                         ' Конец проверки пустоты

    SafeGetDefinition = s                                                          ' Возвращаем итог

End Function                                                                        ' Конец SafeGetDefinition


Function SafeGetPartNumber(prodObj)

    Dim s                                                                           ' Строка результата
    s = ""                                                                         ' Инициализация
    On Error Resume Next                                                           ' Перехват
    s = prodObj.ReferenceProduct.PartNumber                                         ' Пытаемся взять PartNumber у референса
    If Err.Number <> 0 Or Trim(s) = "" Then                                        ' Если не получилось или пусто
        Err.Clear                                                                  ' Сбрасываем
        s = prodObj.PartNumber                                                     ' Пытаемся взять PartNumber у экземпляра
    End If                                                                         ' Конец фолбэка
    On Error GoTo 0                                                                ' Снимаем перехват
    SafeGetPartNumber = s                                                          ' Возвращаем

End Function                                                                        ' Конец SafeGetPartNumber


Function SafeGetNomenclature(prodObj)

    Dim s                                                                           ' Строка результата
    s = ""                                                                         ' Инициализация
    On Error Resume Next                                                           ' Перехват
    s = prodObj.ReferenceProduct.Nomenclature                                      ' Пытаемся взять Nomenclature у референса
    If Err.Number <> 0 Or Trim(s) = "" Then                                        ' Если не получилось/пусто
        Err.Clear                                                                  ' Сбрасываем
        s = prodObj.ReferenceProduct.Name                                          ' Фолбэк на Name референса
    End If                                                                         ' Конец фолбэка
    If Err.Number <> 0 Or Trim(s) = "" Then                                        ' Если всё ещё не получилось
        Err.Clear                                                                  ' Сбрасываем
        s = prodObj.Name                                                           ' Фолбэк на Name экземпляра
    End If                                                                         ' Конец второго фолбэка
    On Error GoTo 0                                                                ' Снимаем перехват
    SafeGetNomenclature = s                                                        ' Возвращаем

End Function                                                                        ' Конец SafeGetNomenclature


' -----------------------------                                                    ' Раздел комментария
' Классификация                                                                     ' Описание
' -----------------------------                                                    ' Раздел комментария
Function IsSGTE(partNumber)

    Dim normalizedPN                                                               ' PartNumber, приведённый к нижнему регистру и без пробелов
    normalizedPN = LCase(Trim(CStr(partNumber)))                                   ' Чистим исходный PartNumber

    Dim ubPrefixes                                                                 ' Индекс последнего префикса из настроек
    ubPrefixes = ArrayLastIndex(gProjectCodePrefixes)                              ' Проверяем, есть ли что-нибудь в списке Project_code

    If ubPrefixes = -1 Then                                                        ' Если список пуст
        IsSGTE = False                                                             ' Нечего сопоставлять — считаем позицию “чужой”
        Exit Function                                                              ' Выходим раньше
    End If                                                                         ' Конец проверки пустого списка

    Dim i                                                                          ' Счётчик по префиксам
    For i = 0 To ubPrefixes                                                        ' Перебираем все заданные префиксы

        Dim prefix                                                                 ' Текущий префикс
        prefix = LCase(Trim(CStr(gProjectCodePrefixes(i))))                        ' Нормализуем префикс из настроек

        If prefix <> "" Then                                                      ' Пустые значения пропускаем
            If Left(normalizedPN, Len(prefix)) = prefix Then                       ' Если PartNumber начинается с префикса
                IsSGTE = True                                                      ' Это “своя” деталь/сборка
                Exit Function                                                      ' Сразу выходим — хватило одного совпадения
            End If                                                                 ' Конец проверки совпадения
        End If                                                                     ' Конец проверки пустого префикса

    Next                                                                           ' Следующий префикс

    IsSGTE = False                                                                 ' Если дошли сюда — совпадений не было

End Function                                                                        ' Конец IsSGTE


Function IsFastener(partNumber, defText)

    Dim s                                                                           ' Строка для поиска
    s = LCase(CStr(partNumber) & " " & CStr(defText))                              ' Склеиваем и приводим к нижнему регистру

    If InStr(s, "din") > 0 Then                                                    ' Англ. DIN
        IsFastener = True                                                          ' Это крепёж
    ElseIf InStr(s, "ост") > 0 Then                                                ' Рус. ОСТ
        IsFastener = True                                                          ' Это крепёж
    ElseIf InStr(s, "ost") > 0 Then                                                ' Англ. OST
        IsFastener = True                                                          ' Это крепёж
    ElseIf InStr(s, "дин") > 0 Then                                                ' Рус. ДИН
        IsFastener = True                                                          ' Это крепёж
    Else                                                                           ' Иначе
        IsFastener = False                                                         ' Не крепёж
    End If                                                                         ' Конец ветвления

End Function                                                                        ' Конец IsFastener


Function IsFabricOrCarbonByMaterial(materialName)

    Dim s                                                                           ' Нормализованная строка
    s = LCase(Trim(CStr(materialName)))                                            ' Нижний регистр + Trim

    ' Важно: НЕ используем "стекло" как признак.                                   ' Пояснение
    If InStr(s, "ткан") > 0 Then                                                   ' Любая "ткань"
        IsFabricOrCarbonByMaterial = True                                          ' Да
    ElseIf InStr(s, "угле") > 0 Then                                               ' "угле..."
        IsFabricOrCarbonByMaterial = True                                          ' Да
    ElseIf InStr(s, "carbon") > 0 Then                                             ' Carbon
        IsFabricOrCarbonByMaterial = True                                          ' Да
    ElseIf InStr(s, "cfrp") > 0 Then                                               ' CFRP
        IsFabricOrCarbonByMaterial = True                                          ' Да
    Else                                                                           ' Иначе
        IsFabricOrCarbonByMaterial = False                                         ' Нет
    End If                                                                         ' Конец ветвления

End Function                                                                        ' Конец IsFabricOrCarbonByMaterial


' -----------------------------                                                    ' Раздел комментария
' Класс материала для столбца N                                                     ' Описание
' Возвращает: "Металл" / "Композит" / "Неметалл" / ""                               ' Описание
' -----------------------------                                                    ' Раздел комментария
Function GuessCompMetalPlusFoam(materialName)

    Dim s                                                                           ' Нормализованная строка материала
    s = LCase(Trim(CStr(materialName)))                                            ' Приводим к нижнему регистру и убираем пробелы

    If s = "" Then                                                                 ' Если материал не задан/не найден
        GuessCompMetalPlusFoam = ""                                                ' Возвращаем пусто (чтобы было видно, что материал не определён)
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки пустого материала

    ' --------------------                                                          ' Блок 1: Композиты (включая пенопласт)
    If InStr(s, "пенопласт") > 0 Then                                              ' Явный пенопласт
        GuessCompMetalPlusFoam = "Композит"                                        ' Считаем композитом (как ты просил)
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки пенопласта

    If InStr(s, "foam") > 0 Or InStr(s, "airex") > 0 Or InStr(s, "roha") > 0 Or InStr(s, "diviny") > 0 Then ' Пены/заполнители в латинице
        GuessCompMetalPlusFoam = "Композит"                                        ' Считаем композитом
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки пенных заполнителей

    If InStr(s, "угл") > 0 Or InStr(s, "угле") > 0 Then                            ' Углеродные материалы (угл/угле)
        GuessCompMetalPlusFoam = "Композит"                                        ' Композит
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки углерода

    If InStr(s, "carbon") > 0 Or InStr(s, "cfrp") > 0 Then                          ' Carbon/CFRP
        GuessCompMetalPlusFoam = "Композит"                                        ' Композит
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки carbon/cfrp

    If InStr(s, "ткан") > 0 Then                                                   ' Любая "ткань" (стекло/уголь/арамид и т.п.)
        GuessCompMetalPlusFoam = "Композит"                                        ' Композит
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки тканевых материалов

    If InStr(s, "стеклопласт") > 0 Or InStr(s, "gfrp") > 0 Then                    ' Стеклопласт/ GFRP
        GuessCompMetalPlusFoam = "Композит"                                        ' Композит
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки стеклопластика

    If InStr(s, "aramid") > 0 Or InStr(s, "кевл") > 0 Or InStr(s, "kevlar") > 0 Then ' Арамид/кевлар
        GuessCompMetalPlusFoam = "Композит"                                        ' Композит
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки арамидов

    If InStr(s, "эпокс") > 0 Or InStr(s, "epoxy") > 0 Or InStr(s, "смол") > 0 Or InStr(s, "resin") > 0 Then ' Связующие
        GuessCompMetalPlusFoam = "Композит"                                        ' В контексте КД это обычно композитная часть
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки связующих

    ' --------------------                                                          ' Блок 2: Металлы
    If InStr(s, "алю") > 0 Or InStr(s, "д16") > 0 Or InStr(s, "амг") > 0 Or InStr(s, "al ") > 0 Or InStr(s, "al-") > 0 Then ' Алюминиевые сплавы/AL
        GuessCompMetalPlusFoam = "Металл"                                          ' Металл
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки алюминия

    If InStr(s, "сталь") > 0 Or InStr(s, "steel") > 0 Or InStr(s, "12х18") > 0 Or InStr(s, "40х") > 0 Or InStr(s, "aisi") > 0 Then ' Стали/марки
        GuessCompMetalPlusFoam = "Металл"                                          ' Металл
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки стали

    If InStr(s, "титан") > 0 Or InStr(s, "titan") > 0 Or InStr(s, "ti") > 0 Or InStr(s, "вт") > 0 Then ' Титан/ВТ/ Ti
        GuessCompMetalPlusFoam = "Металл"                                          ' Металл
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки титана

    If InStr(s, "магн") > 0 Or InStr(s, "mg") > 0 Then                             ' Магниевые сплавы (очень грубо)
        GuessCompMetalPlusFoam = "Металл"                                          ' Металл
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки магния

    ' --------------------                                                          ' Блок 3: Всё остальное (пластики, резины, керамика и т.п.)
    GuessCompMetalPlusFoam = "Неметалл"                                            ' Если не металл и не композит — считаем неметаллом

End Function                                                                        ' Конец GuessCompMetalPlusFoam


' -----------------------------                                                    ' Раздел комментария
' Payload TSV                                                                       ' Описание
' -----------------------------                                                    ' Раздел комментария
Function MakeTSVLine(depth, kind, label, partNumber, defText, parentPN, qty, codeM, typeN, materialO, massEach, massTotal)

    MakeTSVLine = _
        CStr(depth) & vbTab & _
        CleanTSV(kind) & vbTab & _
        CleanTSV(label) & vbTab & _
        CleanTSV(partNumber) & vbTab & _
        CleanTSV(defText) & vbTab & _
        CleanTSV(parentPN) & vbTab & _
        CStr(qty) & vbTab & _
        CleanTSV(codeM) & vbTab & _
        CleanTSV(typeN) & vbTab & _
        CleanTSV(materialO) & vbTab & _
        Replace(CStr(massEach), ",", ".") & vbTab & _
        Replace(CStr(massTotal), ",", ".")

End Function                                                                        ' Конец MakeTSVLine


Function CleanTSV(s)

    Dim t                                                                           ' Рабочая строка
    t = CStr(s)                                                                    ' Приводим к строке
    t = Replace(t, vbTab, " ")                                                     ' Убираем табуляции (ломают TSV)
    t = Replace(t, vbCr, " ")                                                      ' Убираем CR
    t = Replace(t, vbLf, " ")                                                      ' Убираем LF
    CleanTSV = Trim(t)                                                             ' Возвращаем Trim

End Function                                                                        ' Конец CleanTSV


Function AppendLineReturnIndex(ByRef arr, line)

    Dim ub                                                                          ' Индекс последнего элемента
    ub = ArrayLastIndex(arr)                                                        ' Получаем последний индекс

    If ub = -1 Then                                                                ' Если массив пуст
        ReDim arr(0)                                                               ' Создаём массив из 1 элемента
        arr(0) = line                                                              ' Пишем строку
        AppendLineReturnIndex = 0                                                  ' Возвращаем индекс 0
    Else                                                                           ' Если массив не пуст
        ReDim Preserve arr(ub + 1)                                                 ' Увеличиваем массив на 1
        arr(ub + 1) = line                                                         ' Пишем новую строку
        AppendLineReturnIndex = ub + 1                                             ' Возвращаем индекс добавленного элемента
    End If                                                                         ' Конец ветвления

End Function                                                                        ' Конец AppendLineReturnIndex


' -----------------------------                                                    ' Раздел комментария
' Загрузка настроек из Settings.txt                                                 ' Описание
' -----------------------------                                                    ' Раздел комментария
Function LoadSettingsFromFile(workFolder)

    Dim settingsPath                                                               ' Полный путь к Settings.txt
    settingsPath = workFolder & "\Settings.txt"                                   ' Файл настроек лежит рядом с выгрузкой

    If FileExists(settingsPath) = False Then                                       ' Если Settings.txt нет
        MsgBox "Не найден Settings.txt в папке:" & vbCrLf & workFolder & vbCrLf & _
               "Положи Settings.txt рядом со скриптами и попробуй снова.", vbExclamation, "BOM Extract" ' Понятное сообщение и подсказка
        LoadSettingsFromFile = False                                               ' Сообщаем об ошибке загрузки
        Exit Function                                                              ' Выходим из функции
    End If                                                                        ' Конец проверки наличия файла

    gProjectCodePrefixes = Array()                                                 ' Сбрасываем массив префиксов проекта
    gRepeatingSubassembliesInTree = False                                          ' Дефолт: подсборки суммируются
    gNonDrawingPartsAsMaterials = False                                            ' Дефолт: БЧ-ткань показываем как детали
    gMassOfStandardParts = False                                                   ' Дефолт: массы стандарта не отображаем
    gMassOfPKI = False                                                             ' Дефолт: массы ПКИ не отображаем

    Dim readOk                                                                    ' Флаг успешного чтения файла
    readOk = False                                                                ' Инициализируем ложью

    Dim settingsContent                                                           ' Содержимое файла настроек
    settingsContent = ReadAllText(settingsPath, readOk)                           ' Пробуем прочитать файл целиком

    If readOk = False Then                                                        ' Если прочитать не удалось
        MsgBox "Не удалось прочитать Settings.txt:" & vbCrLf & settingsPath, vbExclamation, "BOM Extract" ' Сообщаем пользователю
        LoadSettingsFromFile = False                                               ' Возвращаем ошибку
        Exit Function                                                              ' Выходим
    End If                                                                        ' Конец проверки чтения

    Dim normalizedText                                                            ' Текст с нормализованными переводами строк
    normalizedText = Replace(settingsContent, vbCrLf, vbLf)                       ' Приводим CRLF к LF
    normalizedText = Replace(normalizedText, vbCr, vbLf)                          ' Убираем одиночные CR

    Dim rows                                                                      ' Массив строк файла
    rows = Split(normalizedText, vbLf)                                            ' Делим файл по строкам

    Dim i                                                                         ' Счётчик строк
    For i = 0 To UBound(rows)                                                     ' Перебираем строки настроек

        Dim line                                                                  ' Текущая строка
        line = Trim(CStr(rows(i)))                                                ' Обрезаем пробелы вокруг

        If line = "" Then                                                        ' Пустые строки пропускаем
            ' Пропуск                                                            ' Пояснение
        ElseIf InStr(line, "=") = 0 Then                                         ' Если нет разделителя ключ=значение
            ' Пропуск                                                            ' Пояснение
        Else                                                                      ' Нашли потенциальную пару ключ=значение

            Dim eqPos                                                             ' Позиция символа "="
            eqPos = InStr(line, "=")                                            ' Ищем индекс разделителя

            Dim keyText                                                           ' Имя параметра
            keyText = Trim(Left(line, eqPos - 1))                                 ' Берём часть слева от "=" и чистим

            Dim valueText                                                         ' Текст значения параметра
            valueText = Trim(Mid(line, eqPos + 1))                                ' Берём часть справа и чистим

            Select Case LCase(keyText)                                            ' Определяем параметр по имени
                Case "project_code"                                              ' Список префиксов проекта
                    gProjectCodePrefixes = ParseProjectCodeList(valueText)        ' Парсим список в массив
                Case "repeating_subassemblies_in_tree"                           ' Флаг повторения подсборок
                    gRepeatingSubassembliesInTree = ParseFlexibleBoolean(valueText) ' Конвертируем строку в bool
                Case "non-drawing_parts_as_materials"                            ' Флаг скрытия БЧ-ткань
                    gNonDrawingPartsAsMaterials = ParseFlexibleBoolean(valueText) ' Конвертируем строку в bool
                Case "mass_of_standard_parts"                                    ' Флаг показа массы стандарта
                    gMassOfStandardParts = ParseFlexibleBoolean(valueText)        ' Конвертируем строку в bool
                Case "mass_of_pki"                                               ' Флаг показа массы ПКИ
                    gMassOfPKI = ParseFlexibleBoolean(valueText)                  ' Конвертируем строку в bool
                Case Else                                                         ' Неизвестный параметр
                    ' Пропускаем неизвестные строки                              ' Пояснение
            End Select                                                            ' Конец выбора по имени параметра

        End If                                                                    ' Конец проверки строки

    Next                                                                          ' Переходим к следующей строке

    LoadSettingsFromFile = True                                                   ' Сообщаем об успешной загрузке

End Function                                                                       ' Конец LoadSettingsFromFile


Function ReadAllText(path, ByRef isOk)

    On Error Resume Next                                                           ' Перехватываем возможные ошибки

    isOk = False                                                                   ' По умолчанию чтение неуспешно

    Dim fso                                                                        ' FileSystemObject
    Set fso = CreateObject("Scripting.FileSystemObject")                           ' Создаём FSO

    Dim f                                                                          ' Текстовый файл
    Set f = fso.OpenTextFile(path, 1, False)                                       ' Открываем на чтение (без автосоздания)

    If Err.Number <> 0 Then                                                        ' Если открыть файл не удалось
        Err.Clear                                                                  ' Чистим ошибку
        ReadAllText = ""                                                          ' Возвращаем пустую строку
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки открытия

    Dim t                                                                          ' Содержимое файла
    t = f.ReadAll                                                                  ' Читаем весь текст
    f.Close                                                                        ' Закрываем файл

    isOk = True                                                                    ' Отмечаем, что чтение прошло успешно
    ReadAllText = CStr(t)                                                          ' Возвращаем текст как строку

    On Error GoTo 0                                                                ' Снимаем перехват

End Function                                                                        ' Конец ReadAllText


Function ParseFlexibleBoolean(rawValue)

    Dim t                                                                          ' Рабочая строка со значением
    t = LCase(Trim(CStr(rawValue)))                                                ' Нормализуем регистр и пробелы

    t = Replace(t, Chr(34), " ")                                                  ' Убираем двойные кавычки
    t = Replace(t, "'", " ")                                                     ' Убираем одинарные кавычки
    t = Replace(t, vbTab, " ")                                                    ' Заменяем табы на пробелы
    t = Replace(t, vbCr, " ")                                                     ' Убираем CR
    t = Replace(t, vbLf, " ")                                                     ' Убираем LF

    If InStr(t, " ") > 0 Then                                                     ' Если есть пробелы внутри
        t = Split(t, " ")(0)                                                      ' Берём первое слово (до комментариев)
    End If                                                                         ' Конец обработки пробелов

    ParseFlexibleBoolean = (t = "true" Or t = "1" Or t = "yes" Or t = "y" Or t = "да") ' Преобразуем в булево

End Function                                                                        ' Конец ParseFlexibleBoolean


Function ParseProjectCodeList(rawValue)

    Dim prepared                                                                   ' Текст, подготовленный к разбору
    prepared = CStr(rawValue)                                                      ' Приводим к строке
    prepared = Replace(prepared, Chr(34), " ")                                    ' Убираем двойные кавычки
    prepared = Replace(prepared, "'", " ")                                       ' Убираем одинарные кавычки
    prepared = Replace(prepared, vbCr, " ")                                       ' Убираем CR
    prepared = Replace(prepared, vbLf, " ")                                       ' Убираем LF
    prepared = Replace(prepared, vbTab, " ")                                      ' Заменяем табуляции
    prepared = Replace(prepared, ";", " ")                                       ' Заменяем точки с запятой на пробелы
    prepared = Replace(prepared, ",", " ")                                       ' Заменяем запятые на пробелы
    prepared = Replace(prepared, "|", " ")                                       ' Заменяем вертикальные черты
    prepared = Replace(prepared, "/", " ")                                       ' Заменяем косые черты

    prepared = LCase(prepared)                                                     ' Переводим в нижний регистр
    prepared = Replace(prepared, " or ", " ")                                    ' Поддержка разделителя OR
    prepared = Replace(prepared, "или", " ")                                     ' Поддержка русскоязычного "или"
    prepared = Replace(prepared, "and", " ")                                     ' Убираем слово AND, если вдруг встретится

    Dim parts                                                                      ' Части строки после split
    parts = Split(prepared, " ")                                                  ' Делим по пробелам

    Dim arr                                                                        ' Результирующий массив префиксов
    arr = Array()                                                                  ' Начинаем с пустого массива

    Dim i                                                                          ' Счётчик частей
    For i = 0 To UBound(parts)                                                     ' Перебираем все элементы
        Dim p                                                                      ' Текущий фрагмент
        p = Trim(CStr(parts(i)))                                                   ' Чистим пробелы
        If p <> "" Then                                                           ' Игнорируем пустые элементы
            arr = ArrayAppendValue(arr, p)                                         ' Добавляем префикс в массив
        End If                                                                     ' Конец проверки пустоты
    Next                                                                           ' Следующий элемент

    ParseProjectCodeList = arr                                                     ' Возвращаем массив префиксов

End Function                                                                        ' Конец ParseProjectCodeList


' -----------------------------                                                    ' Раздел комментария
' Файлы/папки/строки                                                                 ' Описание
' -----------------------------                                                    ' Раздел комментария
Function WriteAllTextUnicode(path, text)

    On Error Resume Next                                                           ' Перехват ошибок записи
    Dim fso                                                                        ' FileSystemObject
    Set fso = CreateObject("Scripting.FileSystemObject")                           ' Создаём FSO
    Dim f                                                                          ' Файл
    Set f = fso.CreateTextFile(path, True, True)                                   ' True=overwrite, True=Unicode (UTF-16 LE)
    f.Write text                                                                   ' Пишем текст
    f.Close                                                                        ' Закрываем файл
    If Err.Number <> 0 Then                                                        ' Если ошибка
        Err.Clear                                                                  ' Сбрасываем
        WriteAllTextUnicode = False                                                ' Возвращаем False
    Else                                                                           ' Если без ошибок
        WriteAllTextUnicode = True                                                 ' Возвращаем True
    End If                                                                         ' Конец ветвления
    On Error GoTo 0                                                                ' Снимаем перехват

End Function                                                                        ' Конец WriteAllTextUnicode


Function FileExists(path)

    Dim fso                                                                        ' FileSystemObject
    Set fso = CreateObject("Scripting.FileSystemObject")                           ' Создаём FSO
    FileExists = fso.FileExists(path)                                              ' Проверяем существование

End Function                                                                        ' Конец FileExists


Function GetFolderFromFullPath(fullPath)

    Dim fso                                                                        ' FileSystemObject
    Set fso = CreateObject("Scripting.FileSystemObject")                           ' Создаём FSO
    GetFolderFromFullPath = fso.GetParentFolderName(fullPath)                      ' Возвращаем родительскую папку

End Function                                                                        ' Конец GetFolderFromFullPath


Function Quote(s)

    Quote = Chr(34) & s & Chr(34)                                                  ' Оборачиваем строку в кавычки для командной строки

End Function                                                                        ' Конец Quote


Function ParseStartLevel(s)

    Dim t                                                                          ' Рабочая строка
    t = UCase(Trim(CStr(s)))                                                       ' Нормализуем

    If Left(t, 1) = "G" Then                                                       ' Если начинается с G
        t = Mid(t, 2)                                                              ' Отбрасываем G
    End If                                                                         ' Конец обработки G

    If IsNumeric(t) Then                                                           ' Если остался номер
        ParseStartLevel = CLng(t)                                                  ' Возвращаем число
    Else                                                                           ' Иначе
        ParseStartLevel = -1                                                       ' Ошибка парсинга
    End If                                                                         ' Конец ветвления

End Function                                                                        ' Конец ParseStartLevel


' -----------------------------                                                    ' Раздел комментария
' Массивы                                                                            ' Описание
' -----------------------------                                                    ' Раздел комментария
Function ArrayLastIndex(arr)

    On Error Resume Next                                                           ' Перехват (если массив пустой)
    Dim ub                                                                         ' UBound
    ub = UBound(arr)                                                               ' Пытаемся получить верхнюю границу
    If Err.Number <> 0 Then                                                        ' Если ошибка (массив пуст)
        Err.Clear                                                                  ' Сбрасываем
        ArrayLastIndex = -1                                                        ' Возвращаем -1
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец обработки ошибки
    On Error GoTo 0                                                                ' Снимаем перехват

    If ub < 0 Then                                                                 ' Если вдруг отрицательный
        ArrayLastIndex = -1                                                        ' Возвращаем -1
    Else                                                                           ' Иначе
        ArrayLastIndex = ub                                                        ' Возвращаем индекс
    End If                                                                         ' Конец ветвления

End Function                                                                        ' Конец ArrayLastIndex


Function ArrayAppendValue(arr, value)

    Dim ub                                                                         ' Индекс последнего элемента
    ub = ArrayLastIndex(arr)                                                       ' Получаем индекс

    If ub = -1 Then                                                                ' Если массив пустой
        ReDim arr(0)                                                               ' Создаём 1 элемент
        arr(0) = value                                                             ' Записываем value
    Else                                                                           ' Если массив не пустой
        ReDim Preserve arr(ub + 1)                                                 ' Увеличиваем на 1
        arr(ub + 1) = value                                                        ' Записываем value
    End If                                                                         ' Конец ветвления

    ArrayAppendValue = arr                                                         ' Возвращаем обновлённый массив

End Function                                                                        ' Конец ArrayAppendValue
