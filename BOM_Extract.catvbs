End Function                                                                        ' Конец IsFabricOrCarbonByMaterial


' -----------------------------                                                    ' Раздел комментария
' Класс материала для столбца N                                                     ' Описание
' Возвращает: "Металл" / "Композит" / "Неметалл" / ""                               ' Описание
' -----------------------------                                                    ' Раздел комментария
Function GuessCompMetalPlusFoam(materialName)

    Dim s                                                                           ' Нормализованная строка материала
    s = LCase(Trim(CStr(materialName)))                                            ' Приводим к нижнему регистру и убираем пробелы

    If s = "" Then                                                                 ' Если материал не задан/не найден
        GuessCompMetalPlusFoam = ""                                                ' Возвращаем пусто (чтобы было видно, что материал не определён)
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки пустого материала

    ' --------------------                                                          ' Блок 1: Композиты (включая пенопласт)
    If InStr(s, "пенопласт") > 0 Then                                              ' Явный пенопласт
        GuessCompMetalPlusFoam = "Композит"                                        ' Считаем композитом (как ты просил)
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки пенопласта

    If InStr(s, "foam") > 0 Or InStr(s, "airex") > 0 Or InStr(s, "roha") > 0 Or InStr(s, "diviny") > 0 Then ' Пены/заполнители в латинице
        GuessCompMetalPlusFoam = "Композит"                                        ' Считаем композитом
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки пенных заполнителей

    If InStr(s, "угл") > 0 Or InStr(s, "угле") > 0 Then                            ' Углеродные материалы (угл/угле)
        GuessCompMetalPlusFoam = "Композит"                                        ' Композит
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки углерода
    If IsCompositeByKeywords(s) Then                                               ' Проверяем словарь композитов
        GuessCompMetalPlusFoam = "Композит"                                        ' Возвращаем "Композит"
        Exit Function
    End If

    If InStr(s, "carbon") > 0 Or InStr(s, "cfrp") > 0 Then                          ' Carbon/CFRP
        GuessCompMetalPlusFoam = "Композит"                                        ' Композит
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки carbon/cfrp
    If IsMetalByKeywords(s) Then                                                   ' Проверяем словарь металлов
        GuessCompMetalPlusFoam = "Металл"                                          ' Возвращаем "Металл"
        Exit Function
    End If

    If InStr(s, "ткан") > 0 Then                                                   ' Любая "ткань" (стекло/уголь/арамид и т.п.)
        GuessCompMetalPlusFoam = "Композит"                                        ' Композит
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки тканевых материалов

    If InStr(s, "стеклопласт") > 0 Or InStr(s, "gfrp") > 0 Then                    ' Стеклопласт/ GFRP
        GuessCompMetalPlusFoam = "Композит"                                        ' Композит
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки стеклопластика
    GuessCompMetalPlusFoam = "Неметалл"                                            ' Если не попали в словари — считаем неметаллом

    If InStr(s, "aramid") > 0 Or InStr(s, "кевл") > 0 Or InStr(s, "kevlar") > 0 Then ' Арамид/кевлар
        GuessCompMetalPlusFoam = "Композит"                                        ' Композит
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки арамидов

    If InStr(s, "эпокс") > 0 Or InStr(s, "epoxy") > 0 Or InStr(s, "смол") > 0 Or InStr(s, "resin") > 0 Then ' Связующие
        GuessCompMetalPlusFoam = "Композит"                                        ' В контексте КД это обычно композитная часть
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки связующих

    ' --------------------                                                          ' Блок 2: Металлы
    If InStr(s, "алю") > 0 Or InStr(s, "д16") > 0 Or InStr(s, "амг") > 0 Or InStr(s, "al ") > 0 Or InStr(s, "al-") > 0 Then ' Алюминиевые сплавы/AL
        GuessCompMetalPlusFoam = "Металл"                                          ' Металл
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки алюминия

    If InStr(s, "сталь") > 0 Or InStr(s, "steel") > 0 Or InStr(s, "12х18") > 0 Or InStr(s, "40х") > 0 Or InStr(s, "aisi") > 0 Then ' Стали/марки
        GuessCompMetalPlusFoam = "Металл"                                          ' Металл
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки стали

    If InStr(s, "титан") > 0 Or InStr(s, "titan") > 0 Or InStr(s, "ti") > 0 Or InStr(s, "вт") > 0 Then ' Титан/ВТ/ Ti
        GuessCompMetalPlusFoam = "Металл"                                          ' Металл
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки титана

    If InStr(s, "магн") > 0 Or InStr(s, "mg") > 0 Then                             ' Магниевые сплавы (очень грубо)
        GuessCompMetalPlusFoam = "Металл"                                          ' Металл
        Exit Function                                                              ' Выходим
    End If                                                                         ' Конец проверки магния
End Function                                                                        ' Конец GuessCompMetalPlusFoam

    ' --------------------                                                          ' Блок 3: Всё остальное (пластики, резины, керамика и т.п.)
    GuessCompMetalPlusFoam = "Неметалл"                                            ' Если не металл и не композит — считаем неметаллом

End Function                                                                        ' Конец GuessCompMetalPlusFoam
Function IsMetalByKeywords(materialLower)

    On Error Resume Next
    Dim lb, ub
    lb = LBound(gMetalMarks)
    If Err.Number <> 0 Then
        Err.Clear
        On Error GoTo 0
        IsMetalByKeywords = False
        Exit Function
    End If
    ub = UBound(gMetalMarks)
    On Error GoTo 0

    Dim i
    For i = lb To ub
        If Trim(CStr(gMetalMarks(i))) <> "" Then
            If InStr(materialLower, LCase(CStr(gMetalMarks(i)))) > 0 Then
                IsMetalByKeywords = True
                Exit Function
            End If
        End If
    Next

    IsMetalByKeywords = False

End Function                                                                        ' Конец IsMetalByKeywords


Function IsCompositeByKeywords(materialLower)

    On Error Resume Next
    Dim lb, ub
    lb = LBound(gCompositeKeywords)
    If Err.Number <> 0 Then
        Err.Clear
        On Error GoTo 0
        IsCompositeByKeywords = False
        Exit Function
    End If
    ub = UBound(gCompositeKeywords)
    On Error GoTo 0

    Dim i
    For i = lb To ub
        Dim item
        item = gCompositeKeywords(i)
        Dim kw
        kw = CStr(item(1))
        Dim mode
        mode = LCase(CStr(item(2)))
        If mode = "regex" Then
            Dim re
            Set re = CreateObject("VBScript.RegExp")
            re.IgnoreCase = True
            re.Global = False
            re.Pattern = kw
            If re.Test(materialLower) Then
                IsCompositeByKeywords = True
                Exit Function
            End If
        Else
            If InStr(materialLower, kw) > 0 Then
                IsCompositeByKeywords = True
                Exit Function
            End If
        End If
    Next

    IsCompositeByKeywords = False

End Function                                                                        ' Конец IsCompositeByKeywords


Function IsFabricMaterial(materialLower)

    On Error Resume Next
    Dim lb, ub
    lb = LBound(gFabricKeywords)
    If Err.Number <> 0 Then
        Err.Clear
        On Error GoTo 0
        IsFabricMaterial = False
        Exit Function
    End If
    ub = UBound(gFabricKeywords)
    On Error GoTo 0

    Dim i
    For i = lb To ub
        Dim item
        item = gFabricKeywords(i)
        Dim kw
        kw = CStr(item(1))
        Dim mode
        mode = LCase(CStr(item(2)))
        If mode = "regex" Then
            Dim re
            Set re = CreateObject("VBScript.RegExp")
            re.IgnoreCase = True
            re.Global = False
            re.Pattern = kw
            If re.Test(materialLower) Then
                IsFabricMaterial = True
                Exit Function
            End If
        Else
            If InStr(materialLower, kw) > 0 Then
                IsFabricMaterial = True
                Exit Function
            End If
        End If
    Next

    IsFabricMaterial = False

End Function                                                                        ' Конец IsFabricMaterial


Function DetectCode(kindValue, descriptionText)

    Dim descLower
    descLower = LCase(CStr(descriptionText))

    If InStr(descLower, "бч") > 0 Then                                             ' БЧ всегда в приоритете
        DetectCode = "бч"
        Exit Function
    End If

    Dim descRules
    descRules = gCodeRules("descRules")
    Dim i
    For i = LBound(descRules) To UBound(descRules)
        Dim rule
        rule = descRules(i)
        Dim kw
        kw = CStr(rule(0))
        Dim code
        code = CStr(rule(1))
        If kw <> "бч" Then
            If InStr(descLower, kw) > 0 Then
                DetectCode = code
                Exit Function
            End If
        End If
    Next

    Select Case UCase(kindValue)
        Case "ASM"
            DetectCode = gCodeRules("base_asm")
        Case "FAST"
            DetectCode = gCodeRules("base_fast")
        Case "PKI"
            DetectCode = gCodeRules("base_pki")
        Case "MAT"
            DetectCode = gCodeRules("base_mat")
        Case Else
            DetectCode = gCodeRules("base_part")
    End Select

End Function                                                                        ' Конец DetectCode


Function ShouldHideNonDrawingPart(descriptionText, materialName)

    If gNonDrawingPartsAsMaterials = False Then
        ShouldHideNonDrawingPart = False
        Exit Function
    End If

    Dim descLower
    descLower = LCase(CStr(descriptionText))
    If InStr(descLower, "бч") = 0 Then
        ShouldHideNonDrawingPart = False
        Exit Function
    End If

    Dim matLower
    matLower = LCase(CStr(materialName))
    ShouldHideNonDrawingPart = IsFabricMaterial(matLower)

End Function                                                                        ' Конец ShouldHideNonDrawingPart


