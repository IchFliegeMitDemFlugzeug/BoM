' -----------------------------                                                    ' Раздел комментария
' Definition: берём Definition, иначе Nomenclature/Name                             ' Описание
' -----------------------------                                                    ' Раздел комментария
Function SafeGetDefinition(prodObj)

    Dim s                                                                           ' Строка результата
    s = ""                                                                         ' Инициализация

    On Error Resume Next                                                           ' Перехват
    s = prodObj.ReferenceProduct.Definition                                        ' Пытаемся взять Definition у референса
    If Err.Number <> 0 Or Trim(s) = "" Then                                        ' Если не получилось или пусто
        Err.Clear                                                                  ' Сбрасываем ошибку
        s = prodObj.Definition                                                     ' Пытаемся взять Definition у экземпляра
    End If                                                                         ' Конец фолбэка
    On Error GoTo 0                                                                ' Снимаем перехват

    If Trim(s) = "" Then                                                           ' Если всё ещё пусто
        s = SafeGetNomenclature(prodObj)                                            ' Фолбэк на Nomenclature/Name
    End If                                                                         ' Конец проверки пустоты

    SafeGetDefinition = s                                                          ' Возвращаем итог

End Function                                                                        ' Конец SafeGetDefinition


Function SafeGetDescription(prodObj)

    Dim s                                                                           ' Строка результата
    s = ""                                                                         ' Инициализация

    On Error Resume Next                                                           ' Перехватываем ошибки доступа к свойствам
    s = prodObj.ReferenceProduct.Description                                       ' Прямое свойство Description
    If Err.Number <> 0 Then
        Err.Clear
        s = ""
    End If

    If Trim(s) = "" Then
        s = SafeReadUserProperty(prodObj.ReferenceProduct, "Description")          ' Пробуем пользовательское свойство
    End If
    If Trim(s) = "" Then
        s = SafeReadUserProperty(prodObj, "Description")                          ' Фолбэк на экземпляр
    End If
    If Trim(s) = "" Then
        s = SafeReadUserProperty(prodObj, "DESCRIPTION")                          ' Пробуем верхний регистр
    End If

    On Error GoTo 0                                                                 ' Возвращаем обычный режим
    SafeGetDescription = CStr(s)                                                    ' Возвращаем строку

End Function                                                                        ' Конец SafeGetDescription


Function SafeReadUserProperty(obj, propName)

    Dim val                                                                        ' Результат
    val = ""

    On Error Resume Next
    Dim props
    Set props = obj.UserRefProperties
    If Err.Number = 0 Then
        Dim item
        Set item = props.Item(propName)
        If Err.Number = 0 Then
            val = item.Value
        End If
    End If
    On Error GoTo 0

    SafeReadUserProperty = CStr(val)

End Function                                                                        ' Конец SafeReadUserProperty


Function SafeGetPartNumber(prodObj)

    Dim s                                                                           ' Строка результата
    s = ""                                                                         ' Инициализация
    On Error Resume Next                                                           ' Перехват
    s = prodObj.ReferenceProduct.PartNumber                                         ' Пытаемся взять PartNumber у референса
    If Err.Number <> 0 Or Trim(s) = "" Then                                        ' Если не получилось или пусто
        Err.Clear                                                                  ' Сбрасываем
        s = prodObj.PartNumber                                                     ' Пытаемся взять PartNumber у экземпляра
    End If                                                                         ' Конец фолбэка
    On Error GoTo 0                                                                ' Снимаем перехват
    SafeGetPartNumber = s                                                          ' Возвращаем

End Function                                                                        ' Конец SafeGetPartNumber


Function SafeGetNomenclature(prodObj)

    Dim s                                                                           ' Строка результата
    s = ""                                                                         ' Инициализация
    On Error Resume Next                                                           ' Перехват
    s = prodObj.ReferenceProduct.Nomenclature                                      ' Пытаемся взять Nomenclature у референса
    If Err.Number <> 0 Or Trim(s) = "" Then                                        ' Если не получилось/пусто
        Err.Clear                                                                  ' Сбрасываем
        s = prodObj.ReferenceProduct.Name                                          ' Фолбэк на Name референса
    End If                                                                         ' Конец фолбэка
    If Err.Number <> 0 Or Trim(s) = "" Then                                        ' Если всё ещё не получилось
        Err.Clear                                                                  ' Сбрасываем
        s = prodObj.Name                                                           ' Фолбэк на Name экземпляра
    End If                                                                         ' Конец второго фолбэка
    On Error GoTo 0                                                                ' Снимаем перехват
    SafeGetNomenclature = s                                                        ' Возвращаем

End Function                                                                        ' Конец SafeGetNomenclature


' -----------------------------                                                    ' Раздел комментария
' Классификация                                                                     ' Описание
' -----------------------------                                                    ' Раздел комментария
Function IsSGTE(partNumber)

    Dim s                                                                           ' Нормализованная строка
    s = UCase(Trim(CStr(partNumber)))                                              ' Приводим к верхнему регистру и обрезаем
    Dim s                                                                           ' Нормализованная строка номера
    s = UCase(Trim(CStr(partNumber)))                                              ' Приводим к верхнему регистру и обрезаем пробелы

    If Left(s, 4) = "SGTE" Then                                                    ' Латинский префикс
        IsSGTE = True                                                              ' Да
    ElseIf Left(s, 4) = "СГТЕ" Then                                                ' Кириллический префикс
        IsSGTE = True                                                              ' Да
    Else                                                                           ' Иначе
        IsSGTE = False                                                             ' Нет
    End If                                                                         ' Конец ветвления
    If ArrayLastIndex(gProjectCodes) < 0 Then                                      ' Если список кодов проекта пустой
        IsSGTE = False                                                             ' Считаем, что совпадений нет
        Exit Function                                                              ' Выходим, чтобы не падать на пустом массиве
    End If                                                                         ' Конец проверки пустого списка

    Dim idx                                                                         ' Индекс по массиву кодов
    For idx = LBound(gProjectCodes) To UBound(gProjectCodes)                       ' Перебираем все коды проекта

        Dim code                                                                   ' Текущий код из настроек
        code = UCase(CStr(gProjectCodes(idx)))                                     ' Нормализуем код для поиска без учёта регистра

        If Len(code) > 0 Then                                                      ' Пропускаем пустые строки настроек
            If InStr(1, s, code, vbTextCompare) > 0 Then                           ' Ищем вхождение кода в любой части номера
                IsSGTE = True                                                      ' Нашли совпадение
                Exit Function                                                      ' Выходим сразу после первой удачи
            End If                                                                 ' Конец проверки вхождения
        End If                                                                     ' Конец проверки пустого кода

    Next                                                                           ' Следующий код проекта

    IsSGTE = False                                                                 ' Если не нашли ни одного совпадения — False

End Function                                                                        ' Конец IsSGTE


Function IsFastener(partNumber, defText)

    Dim s                                                                           ' Строка для поиска
    s = LCase(CStr(partNumber) & " " & CStr(defText))                              ' Склеиваем и приводим к нижнему регистру

    If InStr(s, "din") > 0 Then                                                    ' Англ. DIN
        IsFastener = True                                                          ' Это крепёж
    ElseIf InStr(s, "ост") > 0 Then                                                ' Рус. ОСТ
        IsFastener = True                                                          ' Это крепёж
    ElseIf InStr(s, "ost") > 0 Then                                                ' Англ. OST
        IsFastener = True                                                          ' Это крепёж
    ElseIf InStr(s, "дин") > 0 Then                                                ' Рус. ДИН
        IsFastener = True                                                          ' Это крепёж
    Else                                                                           ' Иначе
        IsFastener = False                                                         ' Не крепёж
    End If                                                                         ' Конец ветвления

End Function                                                                        ' Конец IsFastener


